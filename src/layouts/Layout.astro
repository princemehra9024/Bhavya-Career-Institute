---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import loopVideo from '../assets/Create_a_short_seamless_loopin.mp4';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content="Bhavya Career Institute, Kota — RSCIT, Tally, Typing, Digital Courses, Spoken English & more. Master the digital world with expert mentors." />
    <title>{title}</title>
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    
    <ClientRouter />
    
    <!-- GSAP & Lenis Scripts for Animation (loaded before body closes for perf, but CDN links here if needed) -->
  </head>
  <body>
    <!-- Custom Cursor -->
    <div class="custom-cursor" id="custom-cursor"></div>

    <header class="header">
      <div class="container header-container">
        <a href="/" class="logo">
          <span class="logo-icon">🎓</span>
          <div class="logo-text-group">
            <span class="logo-text">Bhavya Career Institute</span>
            <span class="logo-tagline">Master the Digital World</span>
          </div>
        </a>
        <nav class="nav">
          <ul>
            <li><a href="/#about" class="nav-link">About us</a></li>
            <li><a href="/#courses" class="nav-link">Services</a></li>
            <li><a href="/#use-cases" class="nav-link">Use Cases</a></li>
            <li><a href="/#pricing" class="nav-link">Pricing</a></li>
            <li><a href="/#blog" class="nav-link">Blog</a></li>
          </ul>
        </nav>
        <div class="auth-buttons">
          <a href="/student" class="btn highlight-btn">
            <span class="btn-icon">👨‍🎓</span> Student Panel
          </a>
        </div>
        <button class="mobile-menu-btn" id="mobile-menu-btn" aria-label="Toggle menu">
          <span></span><span></span><span></span>
        </button>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="footer-modern" id="contact">
      <div class="footer-card-wrapper">
        <div class="footer-card">
          <!-- Top section with massive text -->
          <div class="footer-top">
            <h2 class="massive-text">BHAVYA</h2>
            <div class="footer-slogan">Master the digital world</div>
          </div>

          <!-- Cleaner 4 Column Grid -->
          <div class="footer-grid">
            <div class="footer-col brand-col">
              <div class="creative-space-video">
                <video src={loopVideo} autoplay loop muted playsinline class="footer-video"></video>
              </div>
              <p class="brand-desc">Empowering the next generation of digital professionals with practical skills.</p>
            </div>

            <div class="footer-col">
              <h5>Contact</h5>
              <p>3-N-25 Mahaveer Nagar Extn.<br>Near Ganesh Ji Mandir, Kota</p>
              <br>
              <p>info@bhavyacareer.com<br>+91 96949 32391</p>
            </div>
            
            <div class="footer-col">
              <h5>Quick Links</h5>
              <ul>
                <li><a href="/#courses">Our Courses</a></li>
                <li><a href="/signup">Enroll Now</a></li>
                <li><a href="/login">Student Login</a></li>
                <li><a href="/admin">Admin Portal</a></li>
              </ul>
            </div>
            
            <div class="footer-col newsletter-col">
              <h5>Newsletter & Social</h5>
              <p>Sign up for latest updates.</p>
              <form class="newsletter-form" onsubmit="event.preventDefault();">
                <input type="email" placeholder="Email" required />
                <button type="submit" aria-label="Subscribe">→</button>
              </form>
              <div class="social-links mt-4">
                <a href="#" class="social-btn" aria-label="Instagram">IG</a>
                <a href="#" class="social-btn" aria-label="Facebook">FB</a>
                <a href="#" class="social-btn" aria-label="LinkedIn">LI</a>
              </div>
            </div>
          </div>

          <!-- Bottom bar -->
          <div class="footer-bottom-bar">
            <span>Powered by Bhavya Career Institute</span>
            <span>Privacy Policy</span>
            <span>Copyright © {new Date().getFullYear()}</span>
            <span>All rights reserved.</span>
          </div>
        </div>
      </div>
    </footer>

    <script>
      import gsap from 'gsap';
      import { ScrollTrigger } from 'gsap/ScrollTrigger';
      import Lenis from 'lenis';

      gsap.registerPlugin(ScrollTrigger);

      // --- Lenis Smooth Scrolling ---
      const lenis = new Lenis({
        duration: 1.2,
        easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)), // easeOutQuart
        direction: 'vertical',
        gestureDirection: 'vertical',
        smooth: true,
        mouseMultiplier: 1,
        smoothTouch: false,
        touchMultiplier: 2,
        infinite: false,
      });

      function raf(time) {
        lenis.raf(time);
        requestAnimationFrame(raf);
      }
      requestAnimationFrame(raf);

      // Integrate Lenis with GSAP ScrollTrigger
      lenis.on('scroll', ScrollTrigger.update);
      gsap.ticker.add((time)=>{
        lenis.raf(time * 1000);
      });
      gsap.ticker.lagSmoothing(0, 0);


      // --- Custom Cursor ---
      const initAnimations = () => {
        const cursor = document.getElementById('custom-cursor');
        const interactiveElements = document.querySelectorAll('a, button, input, .course-card');

        if (window.matchMedia("(pointer: fine)").matches && cursor) {
          // Move cursor
          window.addEventListener('mousemove', (e) => {
            gsap.to(cursor, {
              x: e.clientX,
              y: e.clientY,
              duration: 0.1,
              ease: 'power2.out'
            });
          });

          // Hover states
          interactiveElements.forEach((el) => {
            el.addEventListener('mouseenter', () => cursor.classList.add('hovering'));
            el.addEventListener('mouseleave', () => cursor.classList.remove('hovering'));
          });
        } else {
          if(cursor) cursor.style.display = 'none'; // hide on mobile
        }

        // --- Navbar Animation on Load ---
        gsap.from('.header .logo', {
          y: -50,
          opacity: 0,
          duration: 1,
          ease: 'power3.out',
          delay: 0.2
        });

        gsap.from('.nav ul li', {
          y: -30,
          opacity: 0,
          duration: 0.8,
          stagger: 0.1,
          ease: 'power3.out',
          delay: 0.3
        });

        gsap.from('.auth-buttons .btn', {
          x: 30,
          opacity: 0,
          duration: 0.8,
          ease: 'power3.out',
          delay: 0.6
        });

        // --- Mobile menu toggle (existing) ---
        const menuBtn = document.getElementById('mobile-menu-btn');
        const nav = document.querySelector('.nav');
        const authBtns = document.querySelector('.auth-buttons');
        menuBtn?.addEventListener('click', () => {
          menuBtn.classList.toggle('active');
          nav?.classList.toggle('mobile-open');
          authBtns?.classList.toggle('mobile-open');
        });
      };

      // Run on initial load and after view transitions
      initAnimations();
      document.addEventListener('astro:after-swap', initAnimations);
    </script>
  </body>
</html>

<style>
  /* Header */
  .header {
    padding: 0.8rem 1.5rem;
    position: sticky;
    top: 1rem; /* Floating */
    z-index: 100;
    background-color: rgba(255, 255, 255, 0.85);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    width: 98%;
    max-width: 1400px;
    margin: 1rem auto; /* Center floating */
    border-radius: 100px; /* Pill shape */
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.08), 0 1px 3px rgba(0,0,0,0.05); /* Depth */
    border: 1px solid rgba(255, 255, 255, 0.6);
    transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
  }
  
  .header:hover {
    box-shadow: 0 15px 50px rgba(0, 0, 0, 0.12), 0 2px 5px rgba(0,0,0,0.05);
    transform: translateY(-2px);
  }
  
  .header-container {
    display: flex;
    justify-content: space-between;
    align-items: center;
    width: 100%;
  }
  
  .logo {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    text-decoration: none;
  }

  .logo-icon {
    font-size: 1.8rem;
  }

  .logo-text-group {
    display: flex;
    flex-direction: column;
  }

  .logo-text {
    font-family: var(--font-heading);
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--color-text);
    line-height: 1.2;
  }

  .logo-tagline {
    font-size: 0.65rem;
    color: rgba(43,43,43,0.6);
    letter-spacing: 0.5px;
    text-transform: uppercase;
    font-weight: 500;
  }
  
  .nav ul {
    display: flex;
    gap: 0.5rem;
  }
  
  .nav-link {
    font-weight: 600;
    font-size: 1.05rem;
    color: var(--color-dark);
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.5rem 1.2rem;
    border-radius: 100px;
    transition: all 0.3s ease;
    text-decoration: none;
    position: relative;
    z-index: 1;
    white-space: nowrap;
  }
  
  .nav-link::before {
    content: '';
    position: absolute;
    top: 0; left: 0;
    width: 100%; height: 100%;
    background-color: rgba(0,0,0,0.05);
    border-radius: 100px;
    z-index: -1;
    opacity: 0;
    transform: scale(0.8);
    transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
  }
  
  .nav-link:hover::before {
    opacity: 1;
    transform: scale(1);
  }
  
  .nav-link:hover {
    color: var(--color-dark);
  }

  .auth-buttons {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    flex-shrink: 0;
  }
  


  /* Highlight Student Panel Button */
  .highlight-btn {
    background: linear-gradient(135deg, var(--color-dark) 0%, #333 100%);
    color: var(--color-neon);
    border: none;
    border-radius: 100px;
    padding: 0.8rem 1.8rem;
    font-weight: 700;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2);
    display: flex;
    align-items: center;
    gap: 0.5rem;
    position: relative;
    overflow: hidden;
    transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
  }

  .highlight-btn::before {
    content: '';
    position: absolute;
    top: 0; left: -100%;
    width: 100%; height: 100%;
    background: linear-gradient(90deg, transparent, rgba(185, 255, 102, 0.2), transparent);
    transition: all 0.5s ease;
  }

  .highlight-btn:hover {
    transform: scale(1.05) translateY(-2px);
    box-shadow: 0 8px 25px rgba(185, 255, 102, 0.4);
    color: var(--color-white);
    background: var(--color-dark);
  }

  .highlight-btn:hover::before {
    left: 100%;
  }

  .btn-icon {
    font-size: 1.2rem;
  }

  /* Mobile menu button */
  .mobile-menu-btn {
    display: none;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0.5rem;
    z-index: 110;
  }
  .mobile-menu-btn span {
    display: block;
    width: 24px;
    height: 2px;
    background: var(--color-text);
    transition: all 0.3s ease;
    border-radius: 2px;
  }
  .mobile-menu-btn.active span:nth-child(1) { transform: rotate(45deg) translate(5px, 5px); }
  .mobile-menu-btn.active span:nth-child(2) { opacity: 0; }
  .mobile-menu-btn.active span:nth-child(3) { transform: rotate(-45deg) translate(5px, -5px); }
  
  /* ── Modern Footer Redesign ── */
  .footer-modern {
    background-color: var(--color-dark); /* WizardZ Dark Theme */
    padding: 6rem 2rem 4rem; 
    margin-top: 4rem;
    position: relative;
    overflow: hidden;
    color: var(--color-white);
  }
  
  /* Abstract dark background wave/glow */
  .footer-modern::before {
    content: '';
    position: absolute;
    top: -10%;
    right: -10%;
    width: 600px;
    height: 600px;
    background: radial-gradient(circle, rgba(185, 255, 102, 0.15) 0%, transparent 70%);
    border-radius: 50%;
    pointer-events: none;
    z-index: 0;
  }

  .footer-card-wrapper {
    max-width: 1700px; /* Increased width */
    margin: 0 auto;
    width: 100%;
    position: relative;
    z-index: 1;
  }
  
  .footer-card {
    background: var(--color-dark);
    border: 2px solid rgba(255, 255, 255, 0.1);
    border-radius: 40px;
    padding: 6rem 5rem 4rem;
    display: flex;
    flex-direction: column;
    gap: 5.5rem;
    box-shadow: 0 20px 0px rgba(185, 255, 102, 0.2); /* Neon drop shadow */
    position: relative;
    overflow: hidden;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }
  
  .footer-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 25px 0px rgba(185, 255, 102, 0.4);
  }

  /* Decorative glow for impressive look */
  .footer-card::before {
    content: '';
    position: absolute;
    bottom: -20%;
    left: -10%;
    width: 400px;
    height: 400px;
    background: radial-gradient(circle, rgba(185, 255, 102, 0.1) 0%, rgba(255, 255, 255, 0) 70%);
    pointer-events: none;
    z-index: 0;
  }
  
  .footer-card > * {
    position: relative;
    z-index: 1;
  }
  
  /* Top Section: Massive Text */
  .footer-top {
    display: flex;
    justify-content: space-between;
    align-items: center; /* Changed from flex-start to center */
    flex-wrap: nowrap;
    gap: 2rem;
    border-bottom: 2px solid rgba(43,43,43,0.08);
    padding-bottom: 3rem;
  }
  
  .massive-text {
    font-family: var(--font-heading);
    font-size: clamp(3rem, 11vw, 11rem); 
    font-weight: 800;
    line-height: 0.8;
    letter-spacing: -0.04em;
    color: var(--color-white);
    margin: 0;
    text-transform: uppercase;
    text-shadow: 4px 4px 0px var(--color-neon); 
    transition: text-shadow 0.3s ease;
  }
  
  .massive-text:hover {
    text-shadow: 8px 8px 0px var(--color-neon);
  }
  
  .footer-slogan {
    font-family: var(--font-heading);
    font-size: clamp(1.2rem, 2.5vw, 2.5rem);
    color: var(--color-neon); 
    max-width: 350px;
    line-height: 1.2;
    text-align: right;
    font-style: italic;
    opacity: 1;
  }
  
  /* 4 Column Grid */
  .footer-grid {
    display: grid;
    grid-template-columns: 1.2fr 1fr 1fr 1.2fr;
    gap: 3rem;
  }

  .brand-col .brand-desc {
    margin-top: 1.5rem;
    font-size: 0.95rem;
    opacity: 0.7;
    line-height: 1.6;
  }
  
  /* Creative Space Styles */
  .creative-space-video {
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(255,255,255,0.05);
    border: 1px solid rgba(255,255,255,0.2);
    border-radius: 20px;
    transition: all 0.5s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    position: relative;
    padding: 1.5rem;
  }
  
  .creative-space-video:hover {
    transform: scale(1.03) translateY(-8px);
    box-shadow: 0 10px 30px rgba(185, 255, 102, 0.1);
    background: rgba(255,255,255,0.1);
    border-color: var(--color-neon);
  }

  .footer-video {
    width: 100%;
    max-width: 240px;
    height: auto;
    object-fit: contain;
    display: block;
    mix-blend-mode: screen; 
    filter: invert(1) hue-rotate(180deg);
    border-radius: 12px;
  }
  
  .footer-col {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  
  .footer-col h5 {
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    color: var(--color-neon);
    margin-bottom: 1.2rem;
    font-weight: 700;
  }
  
  .footer-col p, .footer-col li {
    font-size: 0.95rem;
    color: var(--color-white); 
    line-height: 1.7;
    font-weight: 400;
    opacity: 0.8;
  }
  
  .footer-col ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
  }
  
  .footer-col a {
    color: var(--color-white); 
    text-decoration: none;
    transition: all 0.3s ease;
    display: inline-flex;
    align-items: center;
    position: relative;
    opacity: 0.8;
  }
  
  .footer-col a::after {
    content: '';
    position: absolute;
    bottom: -2px;
    left: 0;
    width: 0;
    height: 1px;
    background-color: var(--color-neon);
    transition: width 0.3s ease;
  }
  
  .footer-col a:hover {
    color: var(--color-neon); 
    opacity: 1;
    transform: translateX(4px);
  }

  .footer-col a:hover::after {
    width: 100%;
  }
  
  /* Newsletter Form */
  .newsletter-col p {
    margin-bottom: 1.5rem;
  }
  
  .newsletter-form {
    display: flex;
    background: rgba(255,255,255,0.05);
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 50px;
    padding: 0.4rem 0.4rem 0.4rem 1.2rem;
    margin-top: auto;
    transition: all 0.3s ease;
    align-items: center;
  }
  
  .newsletter-form:focus-within {
    background: rgba(255,255,255,0.1);
    border-color: var(--color-neon);
    box-shadow: 0 4px 15px rgba(185, 255, 102, 0.1);
  }
  
  .newsletter-form input {
    background: transparent;
    border: none;
    outline: none;
    color: var(--color-white);
    font-size: 0.95rem;
    flex: 1;
    font-weight: 400;
    font-family: var(--font-body);
  }
  
  .newsletter-form input::placeholder {
    color: rgba(43, 43, 43, 0.4);
  }
  
  .newsletter-form button {
    background: var(--color-neon);
    border: none;
    color: var(--color-dark);
    width: 36px;
    height: 36px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.2rem;
    cursor: pointer;
    transition: transform 0.3s ease, background 0.3s ease;
  }
  
  .newsletter-form button:hover {
    background: var(--color-white);
    transform: translateX(2px) scale(1.05);
  }
  
  .social-links {
    display: flex;
    gap: 1rem;
    margin-top: 1.5rem;
  }

  .social-btn {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    border: 1px solid rgba(255,255,255,0.2);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-white);
    font-size: 0.9rem;
    font-weight: 600;
    transition: all 0.3s ease;
    text-decoration: none;
  }

  .social-btn:hover {
    background: var(--color-neon);
    color: var(--color-dark);
    border-color: var(--color-neon);
    transform: translateY(-3px);
  }
  .social-btn::after { display: none; }
  
  /* Bottom Bar */
  .footer-bottom-bar {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
    padding-top: 2.5rem;
    border-top: 1px solid rgba(255, 255, 255, 0.1); 
    font-size: 0.85rem;
    color: rgba(255, 255, 255, 0.5);
    font-weight: 400;
  }
  
  @media (max-width: 1400px) {
    .footer-grid {
      grid-template-columns: 1.5fr 1fr 1fr;
    }
    .newsletter-col {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 992px) {
    .footer-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 3rem;
    }
    .footer-card {
      padding: 4rem 3rem;
    }
  }
  
  @media (max-width: 768px) {
    .nav, .auth-buttons {
      display: none;
    }
    .nav.mobile-open, .auth-buttons.mobile-open {
      display: flex;
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      background: rgba(255, 255, 255, 0.95);
      backdrop-filter: blur(15px);
      -webkit-backdrop-filter: blur(15px);
      border-radius: 0 0 30px 30px;
      box-shadow: 0 20px 40px rgba(0,0,0,0.1);
      z-index: 105;
      padding: 6rem 2rem 3rem;
      flex-direction: column;
      align-items: center;
      gap: 1.5rem;
      animation: slideDown 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    }
    .nav.mobile-open ul {
      flex-direction: column;
      align-items: center;
      gap: 1.5rem;
    }
    .mobile-menu-btn {
      display: flex;
    }
    
    /* Footer Mobile Adjustments */
    .footer-top {
      flex-direction: column;
      align-items: flex-start;
    }
    .footer-slogan {
      text-align: left;
    }
    .footer-grid {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
    .footer-bottom-bar {
      flex-direction: column;
      text-align: center;
      align-items: center;
    }
  }

  @keyframes slideDown {
    from { opacity: 0; transform: translateY(-10px); }
    to { opacity: 1; transform: translateY(0); }
  }
</style>
