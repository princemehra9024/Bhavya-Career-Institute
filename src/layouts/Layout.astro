---
import '../styles/global.css';
import loopVideo from '../assets/Create_a_short_seamless_loopin.mp4';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content="Bhavya Career Institute, Kota — RSCIT, Tally, Typing, Digital Courses, Spoken English & more. Master the digital world with expert mentors." />
    <title>{title}</title>
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&display=swap" rel="stylesheet">
  </head>
  <body>
    <header class="header fade-up">
      <div class="container header-container">
        <a href="/" class="logo">
          <span class="logo-icon">🎓</span>
          <div class="logo-text-group">
            <span class="logo-text">Bhavya Career Institute</span>
            <span class="logo-tagline">Master the Digital World</span>
          </div>
        </a>
        <nav class="nav">
          <ul>
            <li><a href="/#about">About</a></li>
            <li><a href="/#courses">Courses</a></li>
            <li><a href="/#contact">Contact</a></li>
          </ul>
        </nav>
        <div class="auth-buttons">
          <a href="/login" class="nav-link">Log In</a>
          <a href="/signup" class="btn">Enroll Now</a>
        </div>
        <button class="mobile-menu-btn" id="mobile-menu-btn" aria-label="Toggle menu">
          <span></span><span></span><span></span>
        </button>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="footer-modern" id="contact">
      <div class="footer-card-wrapper">
        <div class="footer-card">
          <!-- Top section with massive text -->
          <div class="footer-top">
            <h2 class="massive-text">BHAVYA</h2>
            <div class="footer-slogan">Master the digital world</div>
          </div>

          <!-- 5 Column Grid (including creative space) -->
          <div class="footer-grid">
            <div class="footer-col">
              <h5>Contact</h5>
              <p>3-N-25 Mahaveer Nagar Extn.<br>Near Ganesh Ji Mandir, Kota</p>
              <br>
              <p>info@bhavyacareer.com<br>+91 96949 32391</p>
            </div>
            
            <div class="footer-col">
              <h5>Quick Links</h5>
              <ul>
                <li><a href="/#courses">Our Courses</a></li>
                <li><a href="/signup">Enroll Now</a></li>
                <li><a href="/login">Student Login</a></li>
                <li><a href="/admin">Admin Portal</a></li>
              </ul>
            </div>
            
            <div class="footer-col">
              <h5>Follow Us</h5>
              <ul>
                <li><a href="#">Instagram</a></li>
                <li><a href="#">Facebook</a></li>
                <li><a href="#">LinkedIn</a></li>
              </ul>
            </div>
            
            <div class="footer-col newsletter-col">
              <h5>Newsletter</h5>
              <p>Sign up for latest updates.</p>
              <form class="newsletter-form" onsubmit="event.preventDefault();">
                <input type="email" placeholder="Email" required />
                <button type="submit" aria-label="Subscribe">→</button>
              </form>
            </div>

            <!-- Empty space for creativity -->
            <div class="footer-col creative-space-video">
              <video src={loopVideo} autoplay loop muted playsinline class="footer-video"></video>
            </div>
          </div>

          <!-- Bottom bar -->
          <div class="footer-bottom-bar">
            <span>Powered by Bhavya Career Institute</span>
            <span>Privacy Policy</span>
            <span>Copyright © {new Date().getFullYear()}</span>
            <span>All rights reserved.</span>
          </div>
        </div>
      </div>
    </footer>

    <script>
      // Intersection Observer for fade-up animations
      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('visible');
          }
        });
      }, {
        threshold: 0.1
      });

      document.querySelectorAll('.fade-up').forEach((el) => {
        observer.observe(el);
      });

      // Mobile menu toggle
      const menuBtn = document.getElementById('mobile-menu-btn');
      const nav = document.querySelector('.nav');
      const authBtns = document.querySelector('.auth-buttons');
      menuBtn?.addEventListener('click', () => {
        menuBtn.classList.toggle('active');
        nav?.classList.toggle('mobile-open');
        authBtns?.classList.toggle('mobile-open');
      });
    </script>
  </body>
</html>

<style>
  /* Header */
  .header {
    padding: 1rem 0;
    position: sticky;
    top: 0;
    z-index: 100;
    background-color: rgba(232, 224, 210, 0.92);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid rgba(255,255,255,0.3);
  }
  
  .header-container {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  
  .logo {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    text-decoration: none;
  }

  .logo-icon {
    font-size: 1.8rem;
  }

  .logo-text-group {
    display: flex;
    flex-direction: column;
  }

  .logo-text {
    font-family: var(--font-heading);
    font-size: 1.3rem;
    font-weight: 700;
    color: var(--color-text);
    line-height: 1.2;
  }

  .logo-tagline {
    font-size: 0.7rem;
    color: rgba(43,43,43,0.6);
    letter-spacing: 0.5px;
    text-transform: uppercase;
    font-weight: 500;
  }
  
  .nav ul {
    display: flex;
    gap: 2rem;
  }
  
  .nav a {
    font-weight: 500;
    transition: color 0.3s ease;
    font-size: 0.95rem;
  }
  
  .nav a:hover {
    color: var(--color-secondary);
  }
  
  .auth-buttons {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }
  
  .nav-link {
    font-weight: 500;
    transition: color 0.3s ease;
  }
  
  .nav-link:hover {
    color: var(--color-secondary);
  }

  /* Mobile menu button */
  .mobile-menu-btn {
    display: none;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0.5rem;
    z-index: 110;
  }
  .mobile-menu-btn span {
    display: block;
    width: 24px;
    height: 2px;
    background: var(--color-text);
    transition: all 0.3s ease;
    border-radius: 2px;
  }
  .mobile-menu-btn.active span:nth-child(1) { transform: rotate(45deg) translate(5px, 5px); }
  .mobile-menu-btn.active span:nth-child(2) { opacity: 0; }
  .mobile-menu-btn.active span:nth-child(3) { transform: rotate(-45deg) translate(5px, -5px); }
  
  /* ── Modern Footer Redesign ── */
  .footer-modern {
    background-color: var(--color-text); /* Matches theme dark color */
    padding: 5rem 2rem;
    margin-top: 4rem;
  }
  
  .footer-card-wrapper {
    max-width: 1700px; /* Increased width */
    margin: 0 auto;
    width: 100%;
  }
  
  .footer-card {
    background: linear-gradient(145deg, var(--color-primary), #e3dac8);
    border-radius: 40px;
    padding: 5rem 5rem 3.5rem;
    display: flex;
    flex-direction: column;
    gap: 4.5rem;
    box-shadow: 0 25px 60px -10px rgba(0, 0, 0, 0.4), inset 0 2px 5px rgba(255,255,255,0.6);
    position: relative;
    overflow: hidden;
  }

  /* Decorative glow for impressive look */
  .footer-card::before {
    content: '';
    position: absolute;
    top: -30%;
    left: -10%;
    width: 600px;
    height: 600px;
    background: radial-gradient(circle, rgba(255,255,255,0.6) 0%, rgba(255,255,255,0) 70%);
    pointer-events: none;
    z-index: 0;
  }
  
  .footer-card > * {
    position: relative;
    z-index: 1;
  }
  
  /* Top Section: Massive Text */
  .footer-top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    flex-wrap: nowrap;
    gap: 2rem;
  }
  
  .massive-text {
    font-family: var(--font-heading);
    font-size: clamp(3rem, 11vw, 11rem); /* Resized so it doesn't wrap */
    font-weight: 800;
    line-height: 0.75;
    letter-spacing: -0.05em;
    color: var(--color-text); /* Matched to website theme */
    margin: 0;
    text-transform: uppercase;
  }
  
  .footer-slogan {
    font-family: var(--font-heading);
    font-size: clamp(1rem, 2.5vw, 2.2rem);
    color: var(--color-text); /* Matched to website theme */
    max-width: 300px;
    line-height: 1.2;
    text-align: right;
    margin-top: 0.5rem;
  }
  
  /* 5 Column Grid */
  .footer-grid {
    display: grid;
    grid-template-columns: 1.5fr 1fr 1fr 1.5fr 1.5fr; /* 5 columns with creative space */
    gap: 2.5rem;
  }
  
  /* Creative Space Styles */
  .creative-space-video {
    display: flex;
    align-items: center;
    justify-content: center;
    background: transparent;
    transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    position: relative;
    padding: 1rem;
  }
  
  .creative-space-video:hover {
    transform: scale(1.05) translateY(-5px);
  }

  .footer-video {
    width: 100%;
    max-width: 240px;
    height: auto;
    object-fit: contain;
    display: block;
    mix-blend-mode: multiply; /* Blends the video background seamlessly with the page */
    filter: contrast(1.1) brightness(0.95); /* Enhances the ink lines */
    border-radius: 12px;
  }
  
  .footer-col {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  
  .footer-col h5 {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 1px;
    color: rgba(43, 43, 43, 0.5); /* Dimmed navy */
    margin-bottom: 1rem;
    font-weight: 700;
  }
  
  .footer-col p, .footer-col li {
    font-size: 0.95rem;
    color: var(--color-text); /* Matched theme */
    line-height: 1.6;
    font-weight: 500;
  }
  
  .footer-col ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  
  .footer-col a {
    color: var(--color-text); /* Matched theme */
    text-decoration: none;
    transition: opacity 0.3s ease;
  }
  
  .footer-col a:hover {
    opacity: 0.7;
  }
  
  /* Newsletter Form */
  .newsletter-col p {
    margin-bottom: 1.5rem;
  }
  
  .newsletter-form {
    display: flex;
    border-bottom: 1px solid rgba(43, 43, 43, 0.3); /* Theme border */
    padding-bottom: 0.5rem;
    margin-top: auto;
  }
  
  .newsletter-form input {
    background: transparent;
    border: none;
    outline: none;
    color: var(--color-text);
    font-size: 1.1rem;
    flex: 1;
    font-weight: 500;
    font-family: var(--font-heading);
  }
  
  .newsletter-form input::placeholder {
    color: rgba(43, 43, 43, 0.4);
  }
  
  .newsletter-form button {
    background: none;
    border: none;
    color: var(--color-text);
    font-size: 1.2rem;
    cursor: pointer;
    transition: transform 0.3s ease;
  }
  
  .newsletter-form button:hover {
    transform: translateX(5px);
  }
  
  /* Bottom Bar */
  .footer-bottom-bar {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
    padding-top: 2rem;
    border-top: 1px dashed rgba(43, 43, 43, 0.15); /* added subtle line */
    font-size: 0.8rem;
    color: rgba(43, 43, 43, 0.6);
    font-weight: 500;
  }
  
  @media (max-width: 1400px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr 1fr 1.5fr; /* Drops the creative space to bottom or resizes */
    }
    .creative-space {
      grid-column: 1 / -1;
      min-height: 120px;
    }
  }

  @media (max-width: 992px) {
    .footer-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 3rem;
    }
    .footer-card {
      padding: 4rem 3rem;
    }
  }
  
  @media (max-width: 768px) {
    .nav, .auth-buttons {
      display: none;
    }
    .nav.mobile-open, .auth-buttons.mobile-open {
      display: flex;
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      background: var(--color-primary);
      z-index: 105;
      padding: 5rem 2rem 2rem;
      flex-direction: column;
      align-items: center;
      gap: 1.5rem;
      animation: slideDown 0.3s ease;
    }
    .nav.mobile-open ul {
      flex-direction: column;
      align-items: center;
      gap: 1.5rem;
    }
    .mobile-menu-btn {
      display: flex;
    }
    
    /* Footer Mobile Adjustments */
    .footer-top {
      flex-direction: column;
      align-items: flex-start;
    }
    .footer-slogan {
      text-align: left;
    }
    .footer-grid {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
    .footer-bottom-bar {
      flex-direction: column;
      text-align: center;
      align-items: center;
    }
  }

  @keyframes slideDown {
    from { opacity: 0; transform: translateY(-10px); }
    to { opacity: 1; transform: translateY(0); }
  }
</style>
