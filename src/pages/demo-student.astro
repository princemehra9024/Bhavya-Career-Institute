---
import DashboardLayout from '../layouts/DashboardLayout.astro';
---

<DashboardLayout title="Student Dashboard Demo | Bhavya Career Institute">
  <div class="demo-banner">
    🎓 DEMO MODE — Student View &nbsp;|&nbsp; <a href="/demo-admin">Switch to Admin Demo →</a>
  </div>

  <div class="dashboard-wrapper">
    <div class="dashboard-container container">
      <!-- Header -->
      <div class="dash-header">
        <div class="dash-header-left">
          <p class="greeting">Good evening 👋</p>
          <h1>Welcome, <span class="name-gradient">Rahul Sharma</span></h1>
          <p class="dash-subtitle">Thursday, August 14, 2026</p>
        </div>
        <div class="dash-header-right">
          <div class="avatar-ring">
            <span>RS</span>
          </div>
          <button class="btn btn-outline btn-sm">Log Out</button>
        </div>
      </div>

      <!-- Course Info Banner -->
      <div class="course-banner">
        <div class="course-banner-left">
          <span class="course-icon">🎓</span>
          <div>
            <p class="course-label">Enrolled Course</p>
            <h3>RSCIT</h3>
          </div>
        </div>
        <div class="course-badge">Active</div>
      </div>

      <!-- Stats Grid -->
      <div class="stats-grid">
        <!-- Attendance Ring -->
        <div class="stat-card ring-card">
          <div class="ring-container">
            <svg viewBox="0 0 100 100" class="progress-ring">
              <circle cx="50" cy="50" r="42" class="ring-bg" />
              <!-- stroke-dashoffset = 263.89 - (86/100)*263.89 = 36.9 -->
              <circle cx="50" cy="50" r="42" class="ring-progress" style="stroke-dashoffset: 36.9;" />
            </svg>
            <div class="ring-text">
              <span class="ring-value">86%</span>
              <span class="ring-label">Attendance</span>
            </div>
          </div>
        </div>

        <!-- Days Present -->
        <div class="stat-card">
          <div class="stat-icon-wrap green">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
          </div>
          <span class="stat-value">18</span>
          <span class="stat-label">Days Present</span>
        </div>

        <!-- Days Absent -->
        <div class="stat-card">
          <div class="stat-icon-wrap red">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>
          </div>
          <span class="stat-value">3</span>
          <span class="stat-label">Days Absent</span>
        </div>

        <!-- Total Classes -->
        <div class="stat-card">
          <div class="stat-icon-wrap blue">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
          </div>
          <span class="stat-value">21</span>
          <span class="stat-label">Total Classes</span>
        </div>
      </div>

      <!-- Submit Attendance Section -->
      <div class="submit-attendance-card">
        <div class="submit-left">
          <div class="submit-icon">📋</div>
          <div>
            <h3>Today's Attendance</h3>
            <p>Mark yourself present for today's class</p>
          </div>
        </div>
        <button class="btn submit-btn" onclick="this.innerHTML='✓ Submitted Successfully!'; this.classList.add('submitted'); this.disabled=true;">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
          Submit Present
        </button>
      </div>

      <!-- Recent Attendance -->
      <div class="attendance-section">
        <div class="section-header-row">
          <h2>Recent Attendance</h2>
          <span class="month-chip">August 2026</span>
        </div>
        <div class="attendance-list-card">
          <ul class="att-list">
            <li class="att-item">
              <div class="att-left">
                <div class="att-day-num">14</div>
                <div class="att-day-info">
                  <strong>Thu</strong>
                  <span>Aug 14, 2026</span>
                </div>
              </div>
              <span class="att-badge badge-present">✓ PRESENT</span>
            </li>
            <li class="att-item">
              <div class="att-left">
                <div class="att-day-num">13</div>
                <div class="att-day-info">
                  <strong>Wed</strong>
                  <span>Aug 13, 2026</span>
                </div>
              </div>
              <span class="att-badge badge-present">✓ PRESENT</span>
            </li>
            <li class="att-item">
              <div class="att-left">
                <div class="att-day-num">12</div>
                <div class="att-day-info">
                  <strong>Tue</strong>
                  <span>Aug 12, 2026</span>
                </div>
              </div>
              <span class="att-badge badge-absent">✗ ABSENT</span>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </div>
</DashboardLayout>
<style>


  .demo-banner {
    background: var(--color-dark);
    color: var(--color-white);
    text-align: center;
    padding: 0.75rem 1rem;
    font-size: 0.9rem;
    font-weight: 600;
    font-family: var(--font-body);
  }
  .demo-banner a {
    color: var(--color-neon);
    font-weight: 700;
  }

  .dashboard-wrapper {
    min-height: 100vh;
    padding-bottom: 2rem;
    background-color: var(--color-light-bg);
  }

  .dashboard-container {
    padding: 2rem;
    max-width: 960px;
    margin: 0 auto;
  }

  /* Header */
  .dash-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: var(--color-white);
    padding: 2rem 2.5rem;
    border-radius: 24px;
    border: 2px solid var(--color-dark);
    box-shadow: 0 8px 0px var(--color-dark);
    margin-bottom: 2rem;
    position: relative;
    overflow: hidden;
  }
  .dash-header::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 6px;
    background: var(--color-neon);
    border-bottom: 2px solid var(--color-dark);
  }
  .greeting {
    font-size: 1rem;
    color: var(--color-dark);
    font-weight: 600;
    margin-bottom: 0.3rem;
  }
  .dash-header h1 {
    font-size: 2rem;
    margin-bottom: 0.3rem;
    font-weight: 700;
    color: var(--color-dark);
  }
  .name-gradient {
    color: var(--color-dark);
    background: var(--color-neon);
    padding: 0 0.5rem;
    border-radius: 8px;
    border: 2px solid var(--color-dark);
  }
  .dash-subtitle {
    font-size: 0.9rem;
    color: var(--color-dark);
    font-weight: 500;
  }
  .dash-header-right {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }
  .avatar-ring {
    width: 60px;
    height: 60px;
    background: var(--color-white);
    border: 2px solid var(--color-dark);
    border-radius: 16px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-dark);
    font-weight: 700;
    font-size: 1.3rem;
    box-shadow: 0 4px 0px var(--color-dark);
  }
  .btn-sm {
    padding: 0.6rem 1.2rem;
    font-size: 0.9rem;
    font-weight: 600;
    background: var(--color-white);
    border: 2px solid var(--color-dark);
    border-radius: 50px;
    cursor: none;
    box-shadow: 0 4px 0px var(--color-dark);
    transition: all 0.3s;
  }
  .btn-sm:hover {
    transform: translateY(2px);
    box-shadow: 0 2px 0px var(--color-dark);
    background: var(--color-light-bg);
  }

  /* Course Banner */
  .course-banner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: var(--color-neon);
    color: var(--color-dark);
    padding: 1.5rem 2rem;
    border-radius: 20px;
    margin-bottom: 2rem;
    border: 2px solid var(--color-dark);
    box-shadow: 0 8px 0px var(--color-dark);
    transition: transform 0.3s ease;
  }
  .course-banner:hover { transform: translateY(-4px); box-shadow: 0 12px 0px var(--color-dark); }
  .course-banner-left {
    display: flex;
    align-items: center;
    gap: 1.2rem;
  }
  .course-icon {
    font-size: 2.2rem;
    background: var(--color-white);
    padding: 0.6rem;
    border-radius: 16px;
    border: 2px solid var(--color-dark);
  }
  .course-label {
    font-size: 0.85rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-bottom: 0.2rem;
  }
  .course-banner h3 {
    font-size: 1.6rem;
    font-family: var(--font-heading);
    font-weight: 800;
  }
  .course-badge {
    background: var(--color-white);
    color: var(--color-dark);
    padding: 0.5rem 1.5rem;
    border-radius: 50px;
    font-size: 0.9rem;
    font-weight: 800;
    letter-spacing: 0.5px;
    border: 2px solid var(--color-dark);
  }

  /* Stats Grid */
  .stats-grid {
    display: grid;
    grid-template-columns: 1.2fr 1fr 1fr 1fr;
    gap: 1.5rem;
    margin-bottom: 2rem;
  }
  .stat-card {
    background: var(--color-white);
    padding: 1.5rem;
    border-radius: 20px;
    text-align: center;
    border: 2px solid var(--color-dark);
    box-shadow: 0 6px 0px var(--color-dark);
    transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    cursor: none;
  }
  .stat-card:hover {
    transform: translateY(-8px);
    box-shadow: 0 14px 0px var(--color-dark);
    background: var(--color-neon);
  }
  .stat-icon-wrap {
    width: 54px;
    height: 54px;
    border-radius: 16px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 0.5rem;
    border: 2px solid var(--color-dark);
    background: var(--color-white);
    color: var(--color-dark);
  }
  .stat-card:hover .stat-icon-wrap {
    background: var(--color-dark);
    color: var(--color-white);
  }
  .stat-value {
    font-size: 2.5rem;
    font-weight: 800;
    font-family: var(--font-heading);
    color: var(--color-dark);
    line-height: 1;
  }
  .stat-label {
    font-size: 0.85rem;
    color: var(--color-dark);
    text-transform: uppercase;
    letter-spacing: 1px;
    font-weight: 700;
  }

  /* Progress Ring */
  .ring-card {
    padding: 1.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .ring-container {
    position: relative;
    width: 140px;
    height: 140px;
  }
  .progress-ring {
    width: 100%;
    height: 100%;
    transform: rotate(-90deg);
  }
  .ring-bg {
    fill: none;
    stroke: var(--color-light-bg);
    stroke-width: 10;
  }
  .stat-card:hover .ring-bg { stroke: var(--color-white); opacity: 0.5; }
  
  .ring-progress {
    fill: none;
    stroke: var(--color-dark);
    stroke-width: 10;
    stroke-linecap: round;
    stroke-dasharray: 263.89;
    stroke-dashoffset: 263.89;
    transition: stroke-dashoffset 1.5s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .ring-text {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    text-align: center;
  }
  .ring-value {
    display: block;
    font-size: 1.8rem;
    font-weight: 800;
    font-family: var(--font-heading);
    color: var(--color-dark);
    line-height: 1;
  }
  .ring-label {
    display: block;
    font-size: 0.75rem;
    color: var(--color-dark);
    text-transform: uppercase;
    letter-spacing: 0.5px;
    margin-top: 0.2rem;
    font-weight: 700;
  }

  /* Submit Attendance */
  .submit-attendance-card {
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: var(--color-white);
    padding: 1.5rem 2rem;
    border-radius: 20px;
    margin-bottom: 2rem;
    border: 2px solid var(--color-dark);
    box-shadow: 0 6px 0px var(--color-dark);
    transition: transform 0.3s ease;
  }
  .submit-attendance-card:hover { transform: translateY(-4px); box-shadow: 0 10px 0px var(--color-dark);}
  .submit-left {
    display: flex;
    align-items: center;
    gap: 1.2rem;
  }
  .submit-icon {
    font-size: 2rem;
    background: var(--color-neon);
    padding: 0.8rem;
    border-radius: 16px;
    border: 2px solid var(--color-dark);
  }
  .submit-left h3 {
    font-size: 1.3rem;
    font-family: var(--font-heading);
    font-weight: 700;
    margin-bottom: 0.2rem;
  }
  .submit-left p {
    font-size: 0.95rem;
    color: var(--color-dark);
    font-weight: 500;
  }
  .submit-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: var(--color-dark);
    color: var(--color-neon);
    padding: 1rem 1.8rem;
    border-radius: 14px;
    font-weight: 700;
    font-size: 1rem;
    white-space: nowrap;
    transition: all 0.3s ease;
    border: 2px solid var(--color-dark);
    cursor: none;
  }
  .submit-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 4px 0px var(--color-neon);
  }
  .submit-btn:disabled {
    cursor: not-allowed;
    transform: none;
  }
  .submit-btn.submitted {
    background: var(--color-neon);
    color: var(--color-dark);
    box-shadow: none;
  }

  /* Attendance Section */
  .attendance-section {
    margin-top: 1rem;
  }
  .section-header-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.5rem;
  }
  .section-header-row h2 {
    font-size: 1.8rem;
    font-weight: 700;
  }
  .month-chip {
    background: var(--color-white);
    padding: 0.5rem 1.5rem;
    border-radius: 50px;
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--color-dark);
    border: 2px solid var(--color-dark);
    box-shadow: 0 4px 0px var(--color-dark);
  }
  .attendance-list-card {
    background: var(--color-white);
    border-radius: 20px;
    border: 2px solid var(--color-dark);
    box-shadow: 0 8px 0px var(--color-dark);
    overflow: hidden;
  }
  .att-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .att-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1.2rem 2rem;
    border-bottom: 2px solid var(--color-dark);
    transition: background 0.2s ease;
  }
  .att-item:last-child { border-bottom: none; }
  .att-item:hover { background: var(--color-neon); }
  .att-left {
    display: flex;
    align-items: center;
    gap: 1.2rem;
  }
  .att-day-num {
    width: 48px;
    height: 48px;
    background: var(--color-white);
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 800;
    font-size: 1.2rem;
    color: var(--color-dark);
    border: 2px solid var(--color-dark);
  }
  .att-day-info strong {
    display: block;
    font-size: 1.1rem;
    margin-bottom: 0.2rem;
    font-weight: 700;
  }
  .att-day-info span {
    font-size: 0.9rem;
    color: var(--color-dark);
    font-weight: 500;
  }
  .att-badge {
    padding: 0.5rem 1.2rem;
    border-radius: 50px;
    font-size: 0.85rem;
    font-weight: 800;
    letter-spacing: 0.5px;
    border: 2px solid var(--color-dark);
  }
  .badge-present {
    background: var(--color-white);
    color: var(--color-dark);
  }
  .att-item:hover .badge-present {
    background: var(--color-dark);
    color: var(--color-neon);
  }
  .badge-absent {
    background: var(--color-dark);
    color: var(--color-white);
  }
  .att-item:hover .badge-absent {
    background: var(--color-white);
    color: var(--color-dark);
  }

  /* Responsive */
  @media (max-width: 768px) {
    .dashboard-container { padding: 1rem; }
    .dash-header {
      flex-direction: column;
      text-align: center;
      gap: 1.5rem;
      padding: 1.5rem;
    }
    .dash-header-right { justify-content: center; }
    .dash-header h1 { font-size: 1.4rem; }
    .stats-grid {
      grid-template-columns: 1fr 1fr;
    }
    .ring-card {
      grid-column: span 2;
    }
    .course-banner {
      flex-direction: column;
      text-align: center;
      gap: 1rem;
    }
    .course-banner-left {
      flex-direction: column;
    }
    .submit-attendance-card {
      flex-direction: column;
      gap: 1rem;
      text-align: center;
    }
    .submit-left {
      flex-direction: column;
    }
    .att-item { padding: 1rem 1.2rem; }
  }
</style>
