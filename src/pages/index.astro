---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import heroImage from '../assets/hero-image.png';
---

<Layout title="Bhavya Career Institute | Master the Digital World">
  <!-- Hero Section -->
  <section class="hero container">
    <div class="hero-content">
      <h1 class="hero-text">Master the digital<br/>landscape for success</h1>
      <p class="hero-text">Bhavya Career Institute helps students grow and succeed in the digital world through a range of professional courses including RSCIT, Tally, Digital Marketing, and Web Development.</p>
      <a href="/signup" class="btn magnetic hero-text">Enroll Now</a>
    </div>
    <div class="hero-visual">
      <Image src={heroImage} alt="Hero Illustration" class="hero-image-animated" width={700} />
    </div>
  </section>

  <!-- Brands Section (Marquee) -->
  <section class="brands-wrapper gsap-reveal">
    <div class="brands-marquee">
      <div class="brands-track">
        <div class="brand">RKCL</div>
        <div class="brand">VMOU</div>
        <div class="brand">Tally</div>
        <div class="brand">RSCIT</div>
        <div class="brand">Microsoft</div>
        <div class="brand">Google</div>
        <!-- Duplicate for infinite scroll -->
        <div class="brand">RKCL</div>
        <div class="brand">VMOU</div>
        <div class="brand">Tally</div>
        <div class="brand">RSCIT</div>
        <div class="brand">Microsoft</div>
        <div class="brand">Google</div>
      </div>
    </div>
  </section>

  <!-- Interactive Dashboard & Attendance Section -->
  <section class="dashboard-section container gsap-reveal" id="student-portal">
    <div class="dashboard-grid">
      
      <!-- Left: Attendance -->
      <div class="attendance-card magnetic-light">
        <div class="attendance-header">
          <h3>Daily Attendance</h3>
          <span class="pulse-indicator"></span>
        </div>
        <p class="attendance-desc">Submit your attendance for today's session quickly and easily.</p>
        
        <form class="attendance-form" onsubmit="event.preventDefault();">
          <div class="input-group">
            <input type="text" id="studentId" required placeholder=" " />
            <label for="studentId">Student ID</label>
          </div>
          <div class="input-group">
            <select id="courseSelect" required>
              <option value="" disabled selected>Select Course</option>
              <option value="rscit">RSCIT</option>
              <option value="tally">Tally</option>
              <option value="digital-marketing">Digital Marketing</option>
            </select>
          </div>
          <button type="submit" class="btn btn-full submit-btn">
            <span class="btn-text">Mark Present</span>
          </button>
        </form>

        <div class="attendance-footer">
          <div class="divider"><span>OR</span></div>
          <a href="/login" class="btn btn-outline btn-full login-btn">Login to Dashboard</a>
        </div>
      </div>

      <!-- Right: Informational / Interactive Dashboard -->
      <div class="info-dashboard">
        <div class="dashboard-glow"></div>
        
        <div class="info-card main-highlight float-anim-1">
          <div class="card-top">
            <span class="highlight-badge">Trending</span>
            <div class="live-dot"></div>
          </div>
          <h3>Learn from the Best</h3>
          <p>Interactive lab sessions, weekly tests, and 1-on-1 mentorship to guarantee your success.</p>
          
          <div class="feature-pills">
            <span class="pill">Smart Classes</span>
            <span class="pill">AC Labs</span>
            <span class="pill">Free WiFi</span>
          </div>
        </div>
        
        <div class="stats-row">
          <div class="info-card mini-stat float-anim-2">
            <div class="circular-progress">
              <svg viewBox="0 0 100 100">
                <circle cx="50" cy="50" r="40" class="bg-circle" />
                <circle cx="50" cy="50" r="40" class="progress-circle" />
              </svg>
              <div class="progress-text">98%</div>
            </div>
            <p>Passing Rate</p>
          </div>
          
          <div class="info-card mini-stat float-anim-3">
            <div class="chart-mini">
              <div class="bar-mini b1"></div>
              <div class="bar-mini b2"></div>
              <div class="bar-mini b3"></div>
              <div class="bar-mini b4"></div>
            </div>
            <p>Career Growth</p>
          </div>
        </div>
      </div>
      
    </div>
  </section>

  <!-- Success Stats Section -->
  <section class="stats-container container gsap-reveal" id="stats">
    <div class="stats-grid">
      <div class="stat-card">
        <h3 class="stat-number">10k+</h3>
        <p>Students Taught</p>
      </div>
      <div class="stat-card">
        <h3 class="stat-number">50+</h3>
        <p>Expert Mentors</p>
      </div>
      <div class="stat-card">
        <h3 class="stat-number">15+</h3>
        <p>Courses Offered</p>
      </div>
      <div class="stat-card">
        <h3 class="stat-number">100%</h3>
        <p>Job Assistance</p>
      </div>
    </div>
  </section>

  <!-- About Journey Section -->
  <section class="journey container gsap-reveal" id="about">
    <div class="section-header">
      <h2>Our Journey</h2>
      <p>Discover how Bhavya Career Institute started and our mission to bridge the digital skill gap.</p>
    </div>
    <div class="journey-content">
      <div class="journey-text">
        <h3>Empowering Students Since 2010</h3>
        <p>What started as a small computer training center has grown into a premier institute for digital education. We believe in practical, hands-on learning that prepares our students for real-world challenges.</p>
        <p>Our goal is to make quality education accessible and to turn beginners into professionals ready to conquer the digital landscape.</p>
        <a href="#courses" class="btn magnetic">Explore Courses</a>
      </div>
      <div class="journey-visual">
        <div class="journey-image-placeholder">
          <svg width="100%" height="100%" viewBox="0 0 400 300" fill="none" xmlns="http://www.w3.org/2000/svg">
            <rect width="400" height="300" rx="30" fill="var(--color-dark)"/>
            <circle cx="200" cy="150" r="80" fill="var(--color-neon)"/>
            <path d="M180 120 L240 150 L180 180 Z" fill="var(--color-dark)"/>
          </svg>
        </div>
      </div>
    </div>
  </section>

  <!-- Courses Section (Services) -->
  <section class="courses container" id="courses">
    <div class="section-header gsap-reveal">
      <h2>Courses</h2>
      <p>At our institute, we offer a range of professional courses to help students master computing, accounting, and digital skills.</p>
    </div>

    <div class="courses-grid">
      <!-- Card 1: RSCIT & Tally -->
      <div class="course-card card-light gsap-reveal">
        <div class="card-content">
          <div class="card-title">
            <span class="highlight-green">RSCIT &</span><br/>
            <span class="highlight-green">Tally</span>
          </div>
          <a href="/signup" class="card-link">
            <span class="icon-circle black"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg></span>
            Learn more
          </a>
        </div>
        <div class="card-illustration">
          <svg width="150" height="120" viewBox="0 0 150 120" fill="none" xmlns="http://www.w3.org/2000/svg">
            <rect x="20" y="20" width="100" height="70" rx="8" fill="white" stroke="black" stroke-width="3"/>
            <path d="M40 40 H100 M40 55 H80 M40 70 H60" stroke="black" stroke-width="3" stroke-linecap="round"/>
            <circle cx="110" cy="80" r="25" fill="#B9FF66" stroke="black" stroke-width="3"/>
            <path d="M100 80 L108 88 L125 70" stroke="black" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </div>
      </div>

      <!-- Card 2: Digital Marketing -->
      <div class="course-card card-dark gsap-reveal">
        <div class="card-content">
          <div class="card-title">
            <span class="highlight-white">Digital</span><br/>
            <span class="highlight-white">Marketing</span>
          </div>
          <a href="/signup" class="card-link light">
            <span class="icon-circle white"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="black" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg></span>
            Learn more
          </a>
        </div>
        <div class="card-illustration">
          <svg width="150" height="120" viewBox="0 0 150 120" fill="none" xmlns="http://www.w3.org/2000/svg">
            <rect x="30" y="30" width="90" height="60" rx="8" fill="black" stroke="white" stroke-width="3"/>
            <circle cx="75" cy="60" r="15" fill="white"/>
            <path d="M10 50 L20 60 L10 70" stroke="white" stroke-width="3" stroke-linecap="round"/>
            <rect x="50" y="80" width="50" height="10" fill="white"/>
          </svg>
        </div>
      </div>

      <!-- Card 3: Web & Programming -->
      <div class="course-card card-dark gsap-reveal">
        <div class="card-content">
          <div class="card-title">
            <span class="highlight-white">Web &</span><br/>
            <span class="highlight-white">Programming</span>
          </div>
          <a href="/signup" class="card-link light">
            <span class="icon-circle white"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="black" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg></span>
            Learn more
          </a>
        </div>
        <div class="card-illustration">
          <svg width="150" height="120" viewBox="0 0 150 120" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M20 40 L60 20 L100 40 L100 80 L60 100 L20 80 Z" fill="black" stroke="white" stroke-width="3" stroke-linejoin="round"/>
            <circle cx="60" cy="60" r="8" fill="#B9FF66"/>
            <path d="M60 20 L60 60" stroke="white" stroke-width="3"/>
            <path d="M20 80 L60 60 L100 80" stroke="white" stroke-width="3"/>
          </svg>
        </div>
      </div>

      <!-- Card 4: Distance Education -->
      <div class="course-card card-light gsap-reveal">
        <div class="card-content">
          <div class="card-title">
            <span class="highlight-green">Distance</span><br/>
            <span class="highlight-green">Education</span>
          </div>
          <a href="/signup" class="card-link">
            <span class="icon-circle black"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg></span>
            Learn more
          </a>
        </div>
        <div class="card-illustration">
          <svg width="150" height="120" viewBox="0 0 150 120" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M20 60 C20 40, 40 20, 75 20 C110 20, 130 40, 130 60 C130 80, 110 100, 75 100 C40 100, 20 80, 20 60 Z" fill="white" stroke="black" stroke-width="3"/>
            <circle cx="45" cy="60" r="10" fill="black"/>
            <circle cx="105" cy="60" r="10" fill="black"/>
            <path d="M65 75 Q75 85 85 75" stroke="black" stroke-width="3" stroke-linecap="round"/>
          </svg>
        </div>
      </div>
    </div>
  </section>

  <!-- Interactive Reviews Section -->
  <section class="reviews container gsap-reveal" id="reviews">
    <div class="section-header">
      <h2>Student Reviews</h2>
      <p>Hear from our successful students who have transformed their careers with our guidance.</p>
    </div>
    <div class="reviews-grid">
      <div class="review-card magnetic-light">
        <div class="review-stars" style="display:flex;gap:4px;">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="#B9FF66" stroke="#B9FF66" stroke-width="2"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="#B9FF66" stroke="#B9FF66" stroke-width="2"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="#B9FF66" stroke="#B9FF66" stroke-width="2"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="#B9FF66" stroke="#B9FF66" stroke-width="2"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="#B9FF66" stroke="#B9FF66" stroke-width="2"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
        </div>
        <p class="review-text">"The RSCIT course at Bhavya was amazing. The teachers are very helpful and I got my certificate easily!"</p>
        <div class="review-author">
          <div class="author-avatar">A</div>
          <div class="author-info">
            <h4>Aman Sharma</h4>
            <span>RSCIT Student</span>
          </div>
        </div>
      </div>
      <div class="review-card magnetic-light">
        <div class="review-stars" style="display:flex;gap:4px;">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="#B9FF66" stroke="#B9FF66" stroke-width="2"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="#B9FF66" stroke="#B9FF66" stroke-width="2"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="#B9FF66" stroke="#B9FF66" stroke-width="2"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="#B9FF66" stroke="#B9FF66" stroke-width="2"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="#B9FF66" stroke="#B9FF66" stroke-width="2"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
        </div>
        <p class="review-text">"Digital Marketing course helped me get a job right after completion. Highly recommended!"</p>
        <div class="review-author">
          <div class="author-avatar">P</div>
          <div class="author-info">
            <h4>Priya Verma</h4>
            <span>Digital Marketing</span>
          </div>
        </div>
      </div>
      <div class="review-card magnetic-light">
        <div class="review-stars" style="display:flex;gap:4px;">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="#B9FF66" stroke="#B9FF66" stroke-width="2"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="#B9FF66" stroke="#B9FF66" stroke-width="2"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="#B9FF66" stroke="#B9FF66" stroke-width="2"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="#B9FF66" stroke="#B9FF66" stroke-width="2"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="#B9FF66" stroke="#B9FF66" stroke-width="2"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
        </div>
        <p class="review-text">"Tally training was very practical. The lab facilities are top-notch and always available."</p>
        <div class="review-author">
          <div class="author-avatar">R</div>
          <div class="author-info">
            <h4>Rahul Singh</h4>
            <span>Tally Student</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="cta container gsap-reveal">
    <div class="cta-box">
      <div class="cta-content">
        <h3>Let's make things happen</h3>
        <p>Contact us today to learn more about how our digital courses can help you grow and succeed in your career.</p>
        <a href="/signup" class="btn magnetic">Enroll Now</a>
      </div>
      <div class="cta-illustration">
        <svg width="250" height="200" viewBox="0 0 250 200" fill="none" xmlns="http://www.w3.org/2000/svg">
          <ellipse cx="125" cy="120" rx="90" ry="25" fill="none" stroke="black" stroke-width="1.5" stroke-dasharray="6 6"/>
          <ellipse cx="125" cy="120" rx="110" ry="35" fill="none" stroke="black" stroke-width="1.5"/>
          
          <circle cx="125" cy="90" r="40" fill="black"/>
          <circle cx="110" cy="85" r="8" fill="white"/>
          <circle cx="140" cy="85" r="8" fill="white"/>
          
          <path d="M125 140 L140 170 L110 170 Z" fill="#B9FF66"/>
          <path d="M190 100 L210 130 L170 130 Z" fill="#E0E0E0"/>
        </svg>
      </div>
    </div>
  </section>

  <!-- Features Section (Case Study style) -->
  <section class="features container">
    <div class="section-header gsap-reveal">
      <h2><span class="highlight-green">Premium</span> Features</h2>
      <p>Explore the exclusive benefits and resources provided to our students to ensure a successful learning journey.</p>
    </div>
    
    <div class="features-box gsap-reveal">
      <div class="feature-col interactive-col">
        <div class="feature-icon-wrapper">
          <div class="emoji-main"><svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 12 20 22 4 22 4 12"></polyline><rect x="2" y="7" width="20" height="5"></rect><line x1="12" y1="22" x2="12" y2="7"></line><path d="M12 7H7.5a2.5 2.5 0 0 1 0-5C11 2 12 7 12 7z"></path><path d="M12 7h4.5a2.5 2.5 0 0 0 0-5C13 2 12 7 12 7z"></path></svg></div>
          <div class="emoji-reaction"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#B9FF66" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v3"></path><path d="M18.36 5.64l-2.12 2.12"></path><path d="M21 12h-3"></path><path d="M18.36 18.36l-2.12-2.12"></path><path d="M12 21v-3"></path><path d="M5.64 18.36l2.12-2.12"></path><path d="M3 12h3"></path><path d="M5.64 5.64l2.12 2.12"></path></svg></div>
        </div>
        <h4>Bonus Learning</h4>
        <p>Get 2 additional digital courses absolutely free on RSCIT admission. Expand your skill set at no extra cost.</p>
        <a href="/#courses" class="feature-link">Learn more <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg></a>
      </div>
      <div class="feature-col interactive-col">
        <div class="feature-icon-wrapper">
          <div class="emoji-main"><svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="8.5" cy="7" r="4"></circle><polyline points="17 11 19 13 23 9"></polyline></svg></div>
          <div class="emoji-reaction"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#B9FF66" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="9" y1="18" x2="15" y2="18"></line><line x1="10" y1="22" x2="14" y2="22"></line><path d="M15.09 14c.18-.98.65-1.74 1.41-2.5A4.65 4.65 0 0 0 18 8 6 6 0 0 0 6 8c0 1 .23 2.23 1.5 3.5A4.61 4.61 0 0 1 8.91 14"></path></svg></div>
        </div>
        <h4>Expert Mentors</h4>
        <p>Learn from industry professionals with real-world experience. Our expert mentors guide you every step of the way.</p>
        <a href="/#courses" class="feature-link">Learn more <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg></a>
      </div>
      <div class="feature-col interactive-col">
        <div class="feature-icon-wrapper">
          <div class="emoji-main"><svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"></path><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"></path></svg></div>
          <div class="emoji-reaction"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#B9FF66" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon></svg></div>
        </div>
        <h4>Resource Library</h4>
        <p>Access our extensive physical and digital library for self-study. A quiet and resourceful space dedicated to your growth.</p>
        <a href="/#courses" class="feature-link">Learn more <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg></a>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* Hero Section */
  .hero {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 6rem 2rem 4rem;
    gap: 2rem;
    position: relative;
  }
  
  .hero::before {
    content: '';
    position: absolute;
    top: 50%; left: 50%;
    transform: translate(-50%, -50%);
    width: 100vw; height: 100%;
    background: radial-gradient(ellipse at top, rgba(185,255,102,0.15) 0%, transparent 60%);
    z-index: -1;
    pointer-events: none;
  }
  
  .hero-content {
    flex: 1;
    max-width: 500px;
  }
  
  .hero-content h1 {
    font-size: 3.5rem;
    font-weight: 500;
    line-height: 1.1;
    margin-bottom: 1.5rem;
  }
  
  .hero-content p {
    font-size: 1.1rem;
    line-height: 1.6;
    margin-bottom: 2rem;
  }
  
  .hero-visual {
    flex: 1;
    display: flex;
    justify-content: flex-end;
  }

  /* Brands Section Marquee */
  .brands-wrapper {
    width: 100%;
    overflow: hidden;
    margin: 4rem auto 6rem;
    padding: 1.5rem 0;
    background-color: var(--color-neon);
    position: relative;
    border-top: 3px solid var(--color-dark);
    border-bottom: 3px solid var(--color-dark);
    transform: rotate(-2deg) scale(1.05); /* Edgy tilt */
    box-shadow: 0 10px 0px rgba(0,0,0,1);
    z-index: 10;
  }
  
  .brands-marquee {
    width: 100%;
    position: relative;
    overflow: hidden;
  }

  .brands-track {
    display: flex;
    align-items: center;
    gap: 6rem;
    width: max-content;
    animation: marquee 20s linear infinite;
  }
  
  .brands-track:hover {
    animation-play-state: paused;
  }

  @keyframes marquee {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }
  
  .brand {
    font-size: 2.5rem;
    font-weight: 800;
    color: var(--color-dark);
    text-transform: uppercase;
    font-family: var(--font-heading);
    transition: transform 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275), color 0.3s ease;
    display: flex;
    align-items: center;
    gap: 3rem;
  }
  
  .brand::after {
    content: '✦';
    font-size: 2rem;
    color: var(--color-white);
    transition: color 0.3s ease;
  }
  
  .brand:hover {
    color: var(--color-white);
    transform: scale(1.1) rotate(2deg);
    cursor: pointer;
  }
  
  .brand:hover::after {
    color: var(--color-dark);
  }

  /* Courses Grid */
  .courses-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2rem;
    margin-bottom: 4rem;
  }
  
  .course-card {
    border-radius: 30px;
    padding: 3rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    box-shadow: 0 5px 0px var(--color-dark);
    transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
  }
  
  .course-card:hover {
    background-color: var(--color-neon);
    color: var(--color-dark);
    transform: translateY(-10px);
    box-shadow: 0 15px 0px var(--color-dark);
  }
  
  .course-card:hover .highlight-green,
  .course-card:hover .highlight-white {
    background-color: var(--color-white);
    color: var(--color-dark);
  }
  
  .course-card:hover .card-link,
  .course-card:hover .card-link.light {
    color: var(--color-dark);
  }
  
  .course-card:hover .icon-circle.white,
  .course-card:hover .icon-circle.black {
    background-color: var(--color-white);
    border: 1px solid var(--color-dark);
  }
  
  .course-card:hover .icon-circle svg {
    stroke: var(--color-dark);
  }
  
  .card-illustration svg {
    transition: transform 0.5s cubic-bezier(0.175, 0.885, 0.32, 1.275);
  }
  
  .course-card:hover .card-illustration svg {
    transform: scale(1.1) rotate(4deg);
  }
  
  .card-light {
    background-color: var(--color-light-bg);
    border: 1px solid var(--color-dark);
  }
  
  .card-dark {
    background-color: var(--color-dark);
    color: var(--color-white);
  }
  
  .card-content {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    height: 100%;
    gap: 4rem;
  }
  
  .card-title {
    font-size: 1.8rem;
    font-weight: 500;
    line-height: 1.3;
  }
  
  .highlight-green {
    background-color: var(--color-neon);
    padding: 0 0.5rem;
    border-radius: 6px;
    color: var(--color-text);
  }
  
  .highlight-white {
    background-color: var(--color-white);
    padding: 0 0.5rem;
    border-radius: 6px;
    color: var(--color-text);
  }
  
  .card-link {
    display: flex;
    align-items: center;
    gap: 1rem;
    font-size: 1.1rem;
    font-weight: 500;
  }
  
  .card-link.light {
    color: var(--color-white);
  }
  
  .icon-circle {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
  }
  
  .icon-circle.black {
    background-color: var(--color-dark);
  }
  
  .icon-circle.white {
    background-color: var(--color-white);
  }

  /* Dashboard & Attendance Section */
  .dashboard-section {
    margin-bottom: 6rem;
  }
  
  .dashboard-grid {
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: 4rem;
    align-items: center;
  }
  
  .attendance-card {
    background: var(--color-white);
    border: 2px solid var(--color-dark);
    border-radius: 30px;
    padding: 3rem;
    box-shadow: 12px 12px 0px var(--color-dark);
    position: relative;
    overflow: hidden;
  }
  
  .attendance-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1rem;
  }
  
  .attendance-header h3 {
    font-size: 2.2rem;
    font-weight: 700;
  }
  
  .pulse-indicator {
    width: 15px;
    height: 15px;
    background-color: var(--color-neon);
    border-radius: 50%;
    box-shadow: 0 0 0 0 rgba(185, 255, 102, 0.7);
    animation: pulse 2s infinite;
  }
  
  @keyframes pulse {
    0% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(185, 255, 102, 0.7); }
    70% { transform: scale(1); box-shadow: 0 0 0 15px rgba(185, 255, 102, 0); }
    100% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(185, 255, 102, 0); }
  }
  
  .attendance-desc {
    font-size: 1.1rem;
    opacity: 0.8;
    margin-bottom: 2.5rem;
  }
  
  .attendance-form .input-group {
    position: relative;
    margin-bottom: 2rem;
  }
  
  .attendance-form input, .attendance-form select {
    width: 100%;
    padding: 1.2rem 1.5rem;
    font-size: 1.1rem;
    border: 2px solid var(--color-dark);
    border-radius: 15px;
    background: var(--color-light-bg);
    outline: none;
    transition: all 0.3s ease;
    font-family: inherit;
    appearance: none;
  }
  
  .attendance-form input:focus, .attendance-form select:focus {
    background: var(--color-white);
    box-shadow: 4px 4px 0px var(--color-neon);
  }
  
  .attendance-form label {
    position: absolute;
    left: 1.5rem;
    top: 50%;
    transform: translateY(-50%);
    font-size: 1.1rem;
    color: rgba(0,0,0,0.5);
    transition: all 0.3s ease;
    pointer-events: none;
  }
  
  .attendance-form input:focus ~ label,
  .attendance-form input:not(:placeholder-shown) ~ label {
    top: -10px;
    font-size: 0.85rem;
    font-weight: 600;
    background: var(--color-white);
    padding: 0 0.5rem;
    color: var(--color-dark);
  }
  
  .btn-full {
    width: 100%;
    padding: 1.2rem;
    font-size: 1.2rem;
    border-radius: 15px;
    position: relative;
    overflow: hidden;
  }
  
  .submit-btn:hover {
    background-color: var(--color-neon);
    color: var(--color-dark);
    border-color: var(--color-neon);
  }
  
  /* Attendance Left Footer */
  .attendance-footer {
    margin-top: 2rem;
  }
  
  .divider {
    display: flex;
    align-items: center;
    text-align: center;
    margin-bottom: 1.5rem;
  }
  
  .divider::before, .divider::after {
    content: '';
    flex: 1;
    border-bottom: 2px dashed rgba(0,0,0,0.1);
  }
  
  .divider span {
    padding: 0 1rem;
    color: rgba(0,0,0,0.4);
    font-weight: 600;
    font-size: 0.9rem;
  }

  .login-btn {
    border: 2px solid var(--color-dark);
    background: transparent;
    transition: all 0.3s ease;
    width: 100%;
    display: inline-block;
  }
  
  .login-btn:hover {
    background: var(--color-dark);
    color: var(--color-white);
    transform: translateY(-2px);
    box-shadow: 0 5px 15px rgba(0,0,0,0.1);
  }

  /* Right Side Info Dashboard */
  .info-dashboard {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }
  
  .dashboard-glow {
    position: absolute;
    top: 50%; left: 50%;
    transform: translate(-50%, -50%);
    width: 120%; height: 120%;
    background: radial-gradient(circle, rgba(185,255,102,0.15) 0%, transparent 70%);
    z-index: -1;
    pointer-events: none;
  }
  
  .info-card {
    background: rgba(25, 26, 35, 0.95);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 24px;
    padding: 2.5rem;
    color: var(--color-white);
    box-shadow: 0 20px 40px rgba(0,0,0,0.15);
  }
  
  .main-highlight {
    position: relative;
    overflow: hidden;
  }
  
  .card-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.5rem;
  }
  
  .highlight-badge {
    background: var(--color-neon);
    color: var(--color-dark);
    padding: 0.4rem 1rem;
    border-radius: 100px;
    font-weight: 700;
    font-size: 0.85rem;
    text-transform: uppercase;
  }
  
  .live-dot {
    width: 12px; height: 12px;
    background: #ff4757;
    border-radius: 50%;
    box-shadow: 0 0 0 0 rgba(255, 71, 87, 0.7);
    animation: livePulse 2s infinite;
  }
  
  @keyframes livePulse {
    0% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(255, 71, 87, 0.7); }
    70% { transform: scale(1); box-shadow: 0 0 0 10px rgba(255, 71, 87, 0); }
    100% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(255, 71, 87, 0); }
  }
  
  .main-highlight h3 {
    font-size: 2rem;
    margin-bottom: 1rem;
  }
  
  .main-highlight p {
    font-size: 1.05rem;
    opacity: 0.8;
    margin-bottom: 2rem;
    line-height: 1.6;
  }
  
  .feature-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
  }
  
  .pill {
    background: rgba(255,255,255,0.1);
    padding: 0.6rem 1.2rem;
    border-radius: 100px;
    font-size: 0.9rem;
    border: 1px solid rgba(255,255,255,0.05);
  }
  
  .stats-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
  }
  
  .mini-stat {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    text-align: center;
  }
  
  .mini-stat p {
    font-weight: 600;
    font-size: 1rem;
  }
  
  /* Circular Progress */
  .circular-progress {
    position: relative;
    width: 80px; height: 80px;
  }
  .circular-progress svg {
    width: 100%; height: 100%;
    transform: rotate(-90deg);
  }
  .bg-circle {
    fill: none;
    stroke: rgba(255,255,255,0.1);
    stroke-width: 8;
  }
  .progress-circle {
    fill: none;
    stroke: var(--color-neon);
    stroke-width: 8;
    stroke-dasharray: 251; /* 2 * pi * 40 = 251.2 */
    stroke-dashoffset: 251;
    stroke-linecap: round;
    animation: fillProgress 2s ease-out forwards 0.5s;
  }
  @keyframes fillProgress {
    to { stroke-dashoffset: 5; /* 98% of 251 is ~246, so offset is 5 */ }
  }
  .progress-text {
    position: absolute;
    top: 50%; left: 50%;
    transform: translate(-50%, -50%);
    font-size: 1.2rem;
    font-weight: 700;
  }
  
  /* Mini Chart */
  .chart-mini {
    display: flex;
    align-items: flex-end;
    gap: 6px;
    height: 80px;
  }
  .bar-mini {
    width: 12px;
    background: var(--color-neon);
    border-radius: 4px;
    animation: barRise 1.5s ease-out forwards;
    transform-origin: bottom;
    transform: scaleY(0);
  }
  .b1 { height: 40%; animation-delay: 0.1s; }
  .b2 { height: 60%; animation-delay: 0.2s; }
  .b3 { height: 85%; animation-delay: 0.3s; }
  .b4 { height: 100%; animation-delay: 0.4s; }
  
  @keyframes barRise {
    to { transform: scaleY(1); }
  }
  
  /* Floating Animations */
  .float-anim-1 {
    animation: float1 6s ease-in-out infinite;
  }
  .float-anim-2 {
    animation: float2 7s ease-in-out infinite;
  }
  
  @keyframes float1 {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-10px); }
  }
  @keyframes float2 {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-15px); }
  }

  /* Stats Section */
  .stats-container {
    margin-bottom: 6rem;
  }
  
  .stats-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 2rem;
    background: var(--color-dark);
    padding: 3rem;
    border-radius: 30px;
    color: var(--color-white);
  }
  
  .stat-card {
    text-align: center;
    padding: 1rem;
    border-right: 1px solid rgba(255,255,255,0.1);
  }
  .stat-card:last-child { border-right: none; }
  
  .stat-number {
    font-size: 3.5rem;
    color: var(--color-neon);
    font-weight: 800;
    margin-bottom: 0.5rem;
  }
  
  /* Journey Section */
  .journey {
    margin-bottom: 6rem;
  }
  
  .journey-content {
    display: flex;
    align-items: center;
    gap: 4rem;
  }
  
  .journey-text {
    flex: 1;
  }
  
  .journey-text h3 {
    font-size: 2rem;
    margin-bottom: 1.5rem;
  }
  
  .journey-text p {
    font-size: 1.1rem;
    line-height: 1.7;
    margin-bottom: 1.5rem;
    opacity: 0.8;
  }
  
  .journey-visual {
    flex: 1;
    display: flex;
    justify-content: center;
  }
  
  .journey-image-placeholder {
    width: 100%;
    max-width: 500px;
    border-radius: 30px;
    overflow: hidden;
    box-shadow: 0 20px 40px rgba(0,0,0,0.1);
    transition: transform 0.5s ease;
  }
  
  .journey-image-placeholder:hover {
    transform: translateY(-10px) scale(1.02);
  }
  
  /* Reviews Section */
  .reviews {
    margin-bottom: 6rem;
  }
  
  .reviews-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
  }
  
  .review-card {
    background: var(--color-white);
    border: 2px solid var(--color-dark);
    border-radius: 20px;
    padding: 2.5rem;
    box-shadow: 0 8px 0px var(--color-dark);
    transition: all 0.3s ease;
    cursor: pointer;
  }
  
  .review-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 15px 0px var(--color-dark);
    background: var(--color-neon);
  }
  
  .review-stars {
    font-size: 1.2rem;
    margin-bottom: 1rem;
  }
  
  .review-text {
    font-size: 1.1rem;
    line-height: 1.6;
    margin-bottom: 2rem;
    font-style: italic;
    font-weight: 500;
  }
  
  .review-author {
    display: flex;
    align-items: center;
    gap: 1rem;
  }
  
  .author-avatar {
    width: 50px;
    height: 50px;
    border-radius: 50%;
    background: var(--color-dark);
    color: var(--color-white);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.2rem;
    font-weight: 700;
  }
  
  .author-info h4 {
    font-size: 1rem;
    margin-bottom: 0.2rem;
  }
  
  .author-info span {
    font-size: 0.85rem;
    opacity: 0.7;
  }

  /* CTA Section */
  .cta-box {
    background-color: var(--color-light-bg);
    border-radius: 30px;
    padding: 4rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 6rem;
  }
  
  .cta-content {
    max-width: 450px;
  }
  
  .cta-content h3 {
    font-size: 2rem;
    margin-bottom: 1rem;
  }
  
  .cta-content p {
    font-size: 1.1rem;
    line-height: 1.6;
    margin-bottom: 2rem;
  }
  
  /* Features Box */
  .features {
    margin-bottom: 6rem;
  }
  
  .features-box {
    background-color: var(--color-dark);
    border-radius: 30px;
    padding: 3rem;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
    color: var(--color-white);
    box-shadow: 0 20px 40px rgba(0,0,0,0.2);
  }
  
  .feature-col {
    padding: 2.5rem;
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    border-radius: 20px;
    transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    background: transparent;
    z-index: 1;
    overflow: hidden;
  }
  
  .feature-col::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(145deg, rgba(255,255,255,0.05) 0%, rgba(255,255,255,0) 100%);
    opacity: 0;
    transition: opacity 0.4s ease;
    z-index: -1;
  }
  
  .feature-col:not(:last-child)::after {
    content: '';
    position: absolute;
    right: -0.5rem;
    top: 10%;
    height: 80%;
    width: 1px;
    background-color: rgba(255,255,255,0.1);
    transition: opacity 0.3s ease;
  }
  
  .feature-col:hover {
    background: rgba(255,255,255,0.03);
    transform: translateY(-10px);
    box-shadow: 0 10px 30px rgba(0,0,0,0.3);
    border: 1px solid rgba(185, 255, 102, 0.2);
  }
  
  .feature-col:hover::before {
    opacity: 1;
  }
  
  .feature-col:hover:not(:last-child)::after {
    opacity: 0;
  }
  
  .feature-icon-wrapper {
    position: relative;
    width: 60px;
    height: 60px;
    margin-bottom: 1.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(255,255,255,0.1);
    border-radius: 16px;
    font-size: 2rem;
  }
  
  .emoji-main {
    transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
  }
  
  .emoji-reaction {
    position: absolute;
    top: -15px;
    right: -15px;
    font-size: 1.5rem;
    opacity: 0;
    transform: scale(0) rotate(-20deg);
    transition: all 0.5s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    pointer-events: none;
  }
  
  .feature-col:hover .emoji-main {
    transform: scale(1.1) rotate(5deg);
  }
  
  .feature-col:hover .emoji-reaction {
    opacity: 1;
    transform: scale(1.2) rotate(10deg);
  }
  
  .feature-col h4 {
    font-size: 1.5rem;
    margin-bottom: 1rem;
    color: var(--color-neon);
    font-weight: 600;
  }
  
  .feature-col p {
    font-size: 1.1rem;
    line-height: 1.7;
    margin-bottom: 2rem;
    color: rgba(255,255,255,0.85);
  }
  
  .feature-link {
    color: var(--color-white);
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 500;
    transition: color 0.3s ease;
    margin-top: auto;
  }
  
  .feature-link svg {
    transition: transform 0.3s ease;
  }
  
  .feature-col:hover .feature-link {
    color: var(--color-neon);
  }
  
  .feature-col:hover .feature-link svg {
    transform: translateX(5px);
  }

  @media (max-width: 992px) {
    .hero {
      flex-direction: column;
      text-align: center;
    }
    .hero-content {
      max-width: 100%;
    }
    .courses-grid {
      grid-template-columns: 1fr;
    }
    .dashboard-grid {
      grid-template-columns: 1fr;
    }
    .stats-row {
      grid-template-columns: 1fr;
    }
    .stats-grid {
      grid-template-columns: repeat(2, 1fr);
      padding: 2rem;
      gap: 2rem 0;
    }
    .stat-card {
      border-right: none;
      border-bottom: 1px solid rgba(255,255,255,0.1);
      padding: 1.5rem 0;
    }
    .stat-card:nth-child(3), .stat-card:nth-child(4) {
      border-bottom: none;
    }
    .journey-content {
      flex-direction: column;
    }
    .reviews-grid {
      grid-template-columns: 1fr;
    }
    .cta-box {
      flex-direction: column;
      text-align: center;
      gap: 2rem;
    }
    .features-box {
      grid-template-columns: 1fr;
      gap: 1.5rem;
      padding: 2rem;
    }
    .feature-col {
      padding: 2rem;
    }
    .feature-col:not(:last-child)::after {
      display: none;
    }
  }

  @media (max-width: 768px) {
    .hero {
      padding: 3rem 1rem 2rem;
    }
    .hero-content h1 {
      font-size: 2.2rem;
