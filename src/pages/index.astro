<script>
  document.addEventListener('DOMContentLoaded', () => {
    const canvas = document.getElementById('scroll-animation-canvas') as HTMLCanvasElement;
    if (!canvas) return;
    
    const context = canvas.getContext('2d');
    const frameCount = 300;
    
    const currentFrame = (index: number) => (
      `/bg-animation/ezgif-frame-${index.toString().padStart(3, '0')}.jpg`
    );

    const images: HTMLImageElement[] = [];
    const imageObj = new Image();
    imageObj.src = currentFrame(1);
    
    imageObj.onload = () => {
      canvas.width = imageObj.naturalWidth || 1280;
      canvas.height = imageObj.naturalHeight || 720;
      context?.drawImage(imageObj, 0, 0);
    }

    // Preload all frames for smooth playback
    const preloadImages = () => {
      for (let i = 1; i <= frameCount; i++) {
        images[i] = new Image();
        images[i].src = currentFrame(i);
      }
    };
    preloadImages();

    let ticking = false;

    window.addEventListener('scroll', () => {
      if (!ticking) {
        window.requestAnimationFrame(() => {
          updateAnimation();
          ticking = false;
        });
        ticking = true;
      }
    });

    function updateAnimation() {
      const scrollTop = window.scrollY;
      const maxScroll = document.documentElement.scrollHeight - window.innerHeight;
      
      // Calculate scroll fraction, cap between 0 and 1
      const scrollFraction = Math.max(0, Math.min(1, scrollTop / maxScroll));
      
      // Map fraction to frame index (1 to 300)
      const frameIndex = Math.min(
        frameCount,
        Math.floor(scrollFraction * frameCount) + 1
      );
      
      if (images[frameIndex] && images[frameIndex].complete) {
        context?.drawImage(images[frameIndex], 0, 0);
      }
    }
  });
</script>
