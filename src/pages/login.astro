---
import AuthLayout from '../layouts/AuthLayout.astro';
---

<AuthLayout title="Bhavya Career Institute | Student Login">
  <div class="auth-split-wrapper">
    <!-- Left: Image & Branding -->
    <div class="auth-image-panel">
      <div class="overlay"></div>
      <img src="https://images.unsplash.com/photo-1522071820081-009f0129c71c?q=80&w=2000&auto=format&fit=crop" alt="Students Learning" class="bg-img" />
      
      <div class="panel-content">
        <a href="/" class="brand-logo">
          <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="var(--color-neon)" stroke-width="2"><path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1 0-5H20"/></svg>
          <h2>Bhavya Career Institute</h2>
        </a>
        
        <div class="quote-box">
          <h2>"Empowering your future with digital mastery."</h2>
          <p>Join thousands of students building their careers with us.</p>
          
          <div class="user-avatars">
            <div class="avatar">👨‍💻</div>
            <div class="avatar">👩‍🎓</div>
            <div class="avatar">👨‍🏫</div>
            <span class="avatar-text">10k+ Students</span>
          </div>
        </div>
      </div>
    </div>
    
    <!-- Right: Login Form -->
    <div class="auth-form-panel">
      <div class="form-container">
        <a href="/" class="back-link">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
          Back to Home
        </a>
        
        <div class="form-header">
          <h1>Welcome Back <span class="wave">👋</span></h1>
          <p>Please enter your details to sign in.</p>
        </div>
        
        <!-- Google Sign-In Button -->
        <button type="button" class="btn google-btn magnetic" id="google-login-btn">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 48 48">
            <path fill="#FFC107" d="M43.6 20H24v8h11.3C33.7 33.2 29.3 36 24 36c-6.6 0-12-5.4-12-12s5.4-12 12-12c3 0 5.7 1.1 7.8 2.9l5.7-5.7C34.1 6.6 29.3 4.5 24 4.5 12.7 4.5 3.5 13.7 3.5 25S12.7 45.5 24 45.5c11 0 20-8 20-20 0-1.3-.1-2.7-.4-4z"/>
            <path fill="#FF3D00" d="M6.3 15.8l6.6 4.8C14.5 17 19 14 24 14c3 0 5.7 1.1 7.8 2.9l5.7-5.7C34.1 8.4 29.3 6 24 6 16.4 6 9.8 10 6.3 15.8z"/>
            <path fill="#4CAF50" d="M24 44c5.2 0 10-2 13.4-5.1l-6.2-5.2C29.3 35.3 26.8 36 24 36c-5.3 0-9.7-2.8-11.3-7H6.4l-.1.1C9.8 38.1 16.4 44 24 44z"/>
            <path fill="#1976D2" d="M43.6 20H24v8h11.3c-.8 2.2-2.3 4.1-4.1 5.5l6.2 5.2C40.8 35.5 44 30.1 44 24c0-1.3-.1-2.7-.4-4z"/>
          </svg>
          Log in with Google
        </button>
        
        <div class="divider"><span>or log in with email</span></div>
        
        <form class="aesthetic-form" onsubmit="event.preventDefault();">
          <div class="input-group">
            <input type="email" id="email" required placeholder=" " />
            <label for="email">Email Address</label>
            <div class="input-highlight"></div>
          </div>
          
          <div class="input-group">
            <input type="password" id="password" required placeholder=" " />
            <label for="password">Password</label>
            <div class="input-highlight"></div>
          </div>
          
          <div class="form-actions">
            <label class="remember-me">
              <input type="checkbox" checked />
              <span class="checkmark"></span>
              Remember for 30 days
            </label>
            <a href="#" class="forgot-link">Forgot password?</a>
          </div>
          
          <button type="button" class="btn auth-btn magnetic" id="login-btn">Log In</button>
        </form>
        
        <div class="auth-switch">
          <p>Don't have an account? <a href="/signup">Sign up for free</a></p>
        </div>
      </div>
    </div>
  </div>
</AuthLayout>

<script>
  import { auth, db, googleProvider } from '../lib/firebase.js';
  import { signInWithEmailAndPassword, signInWithPopup, type User } from 'firebase/auth';
  import { doc, getDoc, setDoc } from 'firebase/firestore';

  function redirectToDashboard(): void {
    window.location.href = '/dashboard';
  }

  async function ensureUserDoc(user: User): Promise<void> {
    const userRef = doc(db, 'users', user.uid);
    const existing = await getDoc(userRef);
    if (!existing.exists()) {
      const email = user.email || '';
      await setDoc(userRef, {
        uid: user.uid,
        name: user.displayName || 'Student',
        email,
        role: 'student',
        status: 'approved',
        course: 'Not Selected',
        createdAt: new Date().toISOString()
      });
    }
  }

  const GOOGLE_ICON = `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 48 48"><path fill="#FFC107" d="M43.6 20H24v8h11.3C33.7 33.2 29.3 36 24 36c-6.6 0-12-5.4-12-12s5.4-12 12-12c3 0 5.7 1.1 7.8 2.9l5.7-5.7C34.1 6.6 29.3 4.5 24 4.5 12.7 4.5 3.5 13.7 3.5 25S12.7 45.5 24 45.5c11 0 20-8 20-20 0-1.3-.1-2.7-.4-4z"/><path fill="#FF3D00" d="M6.3 15.8l6.6 4.8C14.5 17 19 14 24 14c3 0 5.7 1.1 7.8 2.9l5.7-5.7C34.1 8.4 29.3 6 24 6 16.4 6 9.8 10 6.3 15.8z"/><path fill="#4CAF50" d="M24 44c5.2 0 10-2 13.4-5.1l-6.2-5.2C29.3 35.3 26.8 36 24 36c-5.3 0-9.7-2.8-11.3-7H6.4l-.1.1C9.8 38.1 16.4 44 24 44z"/><path fill="#1976D2" d="M43.6 20H24v8h11.3c-.8 2.2-2.3 4.1-4.1 5.5l6.2 5.2C40.8 35.5 44 30.1 44 24c0-1.3-.1-2.7-.4-4z"/></svg> Continue with Google`;

  // --- Google Login ---
  const googleBtn = document.getElementById('google-login-btn') as HTMLButtonElement;
  googleBtn.addEventListener('click', async () => {
    try {
      googleBtn.textContent = 'Opening Google...';
      googleBtn.disabled = true;
      const result = await signInWithPopup(auth, googleProvider);
      await ensureUserDoc(result.user);
      redirectToDashboard();
    } catch (err: unknown) {
      const msg = err instanceof Error ? err.message : 'Google sign-in failed';
      alert(msg);
      googleBtn.innerHTML = GOOGLE_ICON;
      googleBtn.disabled = false;
    }
  });

  // --- Email/Password Login ---
  const loginBtn = document.getElementById('login-btn') as HTMLButtonElement;
  loginBtn.addEventListener('click', async () => {
    const emailInput = document.getElementById('email') as HTMLInputElement;
    const passwordInput = document.getElementById('password') as HTMLInputElement;
    
    if (!emailInput.value || !passwordInput.value) {
      alert('Please enter both email and password');
      return;
    }
    
    try {
      loginBtn.textContent = 'Logging in...';
      loginBtn.disabled = true;
      const userCredential = await signInWithEmailAndPassword(auth, emailInput.value, passwordInput.value);
      redirectToDashboard();
    } catch (err: unknown) {
      const msg = err instanceof Error ? err.message : 'Login failed';
      alert(msg);
      loginBtn.textContent = 'Log In';
      loginBtn.disabled = false;
    }
  });
</script>

<style>
  /* Split Layout */
  .auth-split-wrapper {
    display: flex;
    min-height: 100vh;
    width: 100%;
    background-color: var(--color-white);
  }
  
  /* Left Image Panel */
  .auth-image-panel {
    flex: 1.2;
    position: relative;
    overflow: hidden;
    display: none; /* Hide on mobile */
  }
  
  @media (min-width: 992px) {
    .auth-image-panel {
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      padding: 3rem;
    }
  }
  
  .bg-img {
    position: absolute;
    top: 0; left: 0;
    width: 100%; height: 100%;
    object-fit: cover;
    z-index: 1;
    transform: scale(1.05);
    animation: slowZoom 20s infinite alternate ease-in-out;
  }
  
  @keyframes slowZoom {
    to { transform: scale(1.15); }
  }
  
  .overlay {
    position: absolute;
    top: 0; left: 0;
    width: 100%; height: 100%;
    background: linear-gradient(135deg, rgba(25, 26, 35, 0.9) 0%, rgba(25, 26, 35, 0.4) 100%);
    z-index: 2;
  }
  
  .panel-content {
    position: relative;
    z-index: 3;
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    color: var(--color-white);
  }
  
  .brand-logo {
    display: flex;
    align-items: center;
    gap: 1rem;
    color: var(--color-white);
    text-decoration: none;
    font-family: var(--font-heading);
  }
  
  .brand-logo h2 {
    font-size: 1.5rem;
    font-weight: 700;
  }
  
  .quote-box {
    background: rgba(255, 255, 255, 0.1);
    backdrop-filter: blur(12px);
    border: 1px solid rgba(255,255,255,0.15);
    border-radius: 24px;
    padding: 2.5rem;
    max-width: 90%;
  }
  
  .quote-box h2 {
    font-size: 2.5rem;
    font-weight: 500;
    margin-bottom: 1rem;
    line-height: 1.2;
  }
  
  .quote-box p {
    font-size: 1.1rem;
    opacity: 0.8;
    margin-bottom: 2rem;
  }
  
  .user-avatars {
    display: flex;
    align-items: center;
  }
  
  .avatar {
    width: 40px; height: 40px;
    border-radius: 50%;
    background: var(--color-dark);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.2rem;
    border: 2px solid rgba(255,255,255,0.2);
    margin-left: -10px;
  }
  .avatar:first-child { margin-left: 0; }
  
  .avatar-text {
    margin-left: 1rem;
    font-weight: 600;
    font-size: 1rem;
  }
  
  /* Right Form Panel */
  .auth-form-panel {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2rem;
    background: var(--color-white);
    position: relative;
  }
  
  .form-container { 
    width: 100%;
    max-width: 450px;
  }
  
  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--color-dark);
    margin-bottom: 2.5rem;
    font-size: 0.95rem;
    font-weight: 600;
    transition: transform 0.3s;
  }
  .back-link:hover { transform: translateX(-5px); }
  
  .form-header { margin-bottom: 2.5rem; }
  .form-header h1 { 
    font-size: 2.5rem; 
    margin-bottom: 0.5rem; 
    font-weight: 700; 
    color: var(--color-dark); 
    display: flex;
    align-items: center;
    gap: 10px;
  }
  
  .wave {
    display: inline-block;
    animation: wave-animation 2.5s infinite;
    transform-origin: 70% 70%;
  }
  
  @keyframes wave-animation {
    0% { transform: rotate( 0.0deg) }
    10% { transform: rotate(14.0deg) }  
    20% { transform: rotate(-8.0deg) }
    30% { transform: rotate(14.0deg) }
    40% { transform: rotate(-4.0deg) }
    50% { transform: rotate(10.0deg) }
    60% { transform: rotate( 0.0deg) }  
    100% { transform: rotate( 0.0deg) }
  }
  
  .form-header p { color: rgba(0,0,0,0.5); font-size: 1.05rem;}
  
  .google-btn {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.8rem;
    padding: 1.1rem;
    background: var(--color-white);
    border: 2px solid rgba(0,0,0,0.08);
    border-radius: 16px;
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--color-dark);
    transition: all 0.3s ease;
    margin-bottom: 2rem;
  }
  .google-btn:hover {
    background: #fafafa;
    border-color: rgba(0,0,0,0.15);
    box-shadow: 0 4px 15px rgba(0,0,0,0.05);
  }
  
  .divider {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 2rem;
    color: var(--color-dark);
    font-size: 0.9rem;
    font-weight: 500;
    opacity: 0.4;
  }
  .divider::before, .divider::after {
    content: '';
    flex: 1;
    height: 1px;
    background: var(--color-dark);
  }
  
  /* Modern Input Group */
  .input-group { 
    position: relative; 
    margin-bottom: 1.8rem; 
  }
  
  .input-group input {
    width: 100%;
    padding: 1.4rem 1.2rem 0.6rem;
    background: #f8f9fa;
    border: 2px solid transparent;
    border-radius: 12px;
    font-size: 1.05rem;
    color: var(--color-text);
    transition: all 0.3s ease;
    font-family: inherit;
  }
  
  .input-group input:focus { 
    outline: none; 
    background: var(--color-white);
    border-color: var(--color-neon);
    box-shadow: 0 10px 20px rgba(185, 255, 102, 0.1);
  }
  
  .input-group label {
    position: absolute;
    top: 50%;
    left: 1.2rem;
    transform: translateY(-50%);
    font-size: 1.05rem;
    color: rgba(0,0,0,0.4);
    transition: all 0.3s ease;
    pointer-events: none;
  }
  
  .input-group input:focus + label,
  .input-group input:not(:placeholder-shown) + label {
    top: 0.6rem;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--color-dark);
    transform: none;
  }
  
  .form-actions { 
    display: flex; 
    justify-content: space-between; 
    align-items: center;
    margin-bottom: 2rem; 
  }
  
  .remember-me {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.95rem;
    color: rgba(0,0,0,0.6);
    cursor: pointer;
  }
  
  .remember-me input {
    accent-color: var(--color-neon);
    width: 16px; height: 16px;
    cursor: pointer;
  }
  
  .forgot-link { font-size: 0.95rem; color: var(--color-dark); font-weight: 600; transition: color 0.3s; }
  .forgot-link:hover { color: var(--color-neon); }
  
  .auth-btn { 
    width: 100%; 
    padding: 1.2rem; 
    font-size: 1.15rem; 
    font-weight: 600;
    border: none;
    border-radius: 14px;
    background: var(--color-dark);
    color: var(--color-white);
    transition: all 0.3s ease;
  }
  
  .auth-btn:hover {
    background: var(--color-neon);
    color: var(--color-dark);
    transform: translateY(-3px);
    box-shadow: 0 15px 30px rgba(185, 255, 102, 0.3);
  }
  
  .auth-switch { margin-top: 2rem; text-align: center; font-size: 1rem; color: rgba(0,0,0,0.6); }
  .auth-switch a { color: var(--color-dark); font-weight: 700; transition: color 0.3s; margin-left: 0.5rem; }
  .auth-switch a:hover { color: var(--color-neon); }
</style>

