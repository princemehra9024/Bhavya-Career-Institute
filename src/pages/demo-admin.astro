---
import DashboardLayout from '../layouts/DashboardLayout.astro';

const students = [
  { name: 'Rahul Sharma', email: 'rahul@example.com', course: 'RSCIT', initials: 'RS' },
  { name: 'Priya Patel', email: 'priya@example.com', course: 'Digital Marketing', initials: 'PP' },
  { name: 'Arjun Singh', email: 'arjun@example.com', course: 'Tally', initials: 'AS' },
  { name: 'Ananya Mehta', email: 'ananya@example.com', course: 'Web Development', initials: 'AM' },
  { name: 'Vikram Joshi', email: 'vikram@example.com', course: 'RSCIT', initials: 'VJ' },
  { name: 'Neha Gupta', email: 'neha@example.com', course: 'B.A.', initials: 'NG' },
];
---

<DashboardLayout title="Admin Dashboard Demo | Bhavya Career Institute">
  <div class="demo-banner">
    👨‍🏫 DEMO MODE — Admin / Teacher View &nbsp;|&nbsp; <a href="/demo-student">Switch to Student Demo →</a>
  </div>

  <div class="admin-container container">
    <div class="admin-header">
      <div>
        <p class="welcome-label">Good evening 👋</p>
        <h2>Teacher Dashboard</h2>
        <p class="subtitle">Manage students and mark attendance</p>
      </div>
      <div class="header-right">
        <div class="avatar-admin">BC</div>
        <button class="btn btn-outline">Log Out</button>
      </div>
    </div>

    <!-- Stats -->
    <div class="admin-stats">
      <div class="admin-stat">
        <span class="stat-val">{students.length}</span>
        <span class="stat-lbl">Total Students</span>
      </div>
      <div class="admin-stat">
        <span class="stat-val">5</span>
        <span class="stat-lbl">Courses Active</span>
      </div>
      <div class="admin-stat">
        <span class="stat-val">4</span>
        <span class="stat-lbl">Present Today</span>
      </div>
      <div class="admin-stat">
        <span class="stat-val">86%</span>
        <span class="stat-lbl">Avg Attendance</span>
      </div>
    </div>

    <div class="admin-grid">
      <!-- Student List -->
      <div class="admin-card">
        <div class="card-title-row">
          <h3>All Students</h3>
          <span class="count-badge">{students.length}</span>
        </div>
        <p class="card-subtitle">All enrolled students and their courses.</p>
        
        <ul class="student-list" id="pending-list">
          {students.map((s) => (
            <li class="student-item">
              <div class="student-left">
                <div class="s-avatar">{s.initials}</div>
                <div class="student-info">
                  <strong>{s.name}</strong>
                  <span>{s.email}</span>
                  <small class="course-tag">{s.course}</small>
                </div>
              </div>
            </li>
          ))}
        </ul>
      </div>

      <!-- Attendance Marking -->
      <div class="admin-card">
        <div class="card-title-row">
          <h3>Mark Attendance</h3>
          <span class="today-badge">Today</span>
        </div>
        <p class="card-subtitle">Select a date and mark students present or absent.</p>
        
        <div class="attendance-controls">
          <input type="date" id="attendance-date" class="date-picker" />
          <button class="btn" id="load-btn" onclick="loadStudents()">Load Students</button>
        </div>

        <ul class="student-list" id="attendance-list">
          {students.map((s) => (
            <li class="student-item attendance-item">
              <div class="student-left">
                <div class="s-avatar">{s.initials}</div>
                <div class="student-info">
                  <strong>{s.name}</strong>
                  <span>{s.email}</span>
                </div>
              </div>
              <div class="attendance-btns">
                <button class="present-btn mark-btn" onclick="markPresent(this)">✓ Present</button>
                <button class="absent-btn mark-btn" onclick="markAbsent(this)">✗ Absent</button>
              </div>
            </li>
          ))}
        </ul>

        <div id="save-row" class="save-row">
          <button class="btn save-btn" onclick="saveAttendance()">💾 Save All Attendance</button>
        </div>
      </div>
    </div>
  </div>
</DashboardLayout>

<script>
  // Set today's date
  const picker = document.getElementById('attendance-date') as HTMLInputElement;
  if (picker) picker.valueAsDate = new Date();

  (window as any).markPresent = function(btn: HTMLButtonElement) {
    const item = btn.closest('.student-item') as HTMLElement;
    if (!item) return;
    item.style.borderLeft = '4px solid #4CAF50';
    item.style.background = '#f1f8f1';
    const absent = item.querySelector('.absent-btn') as HTMLButtonElement;
    if (absent) { absent.style.opacity = '0.4'; absent.style.transform = 'scale(0.9)'; }
    btn.style.background = '#4CAF50';
    btn.style.color = 'white';
  };

  (window as any).markAbsent = function(btn: HTMLButtonElement) {
    const item = btn.closest('.student-item') as HTMLElement;
    if (!item) return;
    item.style.borderLeft = '4px solid #f44336';
    item.style.background = '#fff5f5';
    const present = item.querySelector('.present-btn') as HTMLButtonElement;
    if (present) { present.style.opacity = '0.4'; present.style.transform = 'scale(0.9)'; }
    btn.style.background = '#f44336';
    btn.style.color = 'white';
  };

  (window as any).saveAttendance = function() {
    const saveBtn = document.querySelector('#save-row .btn') as HTMLButtonElement;
    if (saveBtn) {
      saveBtn.textContent = '✓ All Attendance Saved!';
      saveBtn.style.background = '#4CAF50';
      saveBtn.style.color = 'white';
      setTimeout(() => {
        saveBtn.textContent = '💾 Save All Attendance';
        saveBtn.style.background = '';
        saveBtn.style.color = '';
      }, 2000);
    }
  };

  (window as any).loadStudents = function() {
    const btn = document.getElementById('load-btn') as HTMLButtonElement;
    btn.textContent = 'Loaded ✓';
    btn.style.background = '#4CAF50';
    btn.style.color = 'white';
    setTimeout(() => {
      btn.textContent = 'Load Students';
      btn.style.background = '';
      btn.style.color = '';
    }, 1500);
  };
</script>
<style>

  .demo-banner {
    background: var(--color-dark);
    color: var(--color-white);
    text-align: center;
    padding: 0.75rem 1rem;
    font-size: 0.9rem;
    font-weight: 600;
    font-family: var(--font-body);
  }
  .demo-banner a { color: var(--color-neon); font-weight: 700; }

  .admin-container { 
    padding: 3rem 2rem 5rem;
    max-width: 1200px;
    margin: 0 auto;
  }

  .admin-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: var(--color-white);
    padding: 2rem 2.5rem;
    border-radius: 24px;
    border: 2px solid var(--color-dark);
    box-shadow: 0 8px 0px var(--color-dark);
    margin-bottom: 2rem;
    position: relative;
    overflow: hidden;
  }
  .admin-header::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 6px;
    background: var(--color-neon);
    border-bottom: 2px solid var(--color-dark);
  }
  .welcome-label { font-size: 1rem; color: var(--color-dark); font-weight: 600; margin-bottom: 0.3rem; }
  .admin-header h2 { font-size: 2.2rem; margin-bottom: 0.3rem; font-weight: 700; color: var(--color-dark); }
  .subtitle { color: var(--color-dark); font-size: 0.95rem; font-weight: 500; }
  
  .header-right { display: flex; align-items: center; gap: 1.5rem; }
  .avatar-admin {
    width: 60px; height: 60px;
    background: var(--color-white);
    border: 2px solid var(--color-dark);
    border-radius: 16px;
    display: flex; align-items: center; justify-content: center;
    font-weight: 700; font-size: 1.3rem; color: var(--color-dark);
    box-shadow: 0 4px 0px var(--color-dark);
  }

  /* Stats */
  .admin-stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5rem;
    margin-bottom: 2rem;
  }
  @media(max-width: 768px) { .admin-stats { grid-template-columns: 1fr 1fr; } }
  .admin-stat {
    background: var(--color-white);
    padding: 1.5rem;
    border-radius: 20px;
    text-align: center;
    border: 2px solid var(--color-dark);
    box-shadow: 0 6px 0px var(--color-dark);
    transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    cursor: none;
  }
  .admin-stat:hover { 
    transform: translateY(-8px); 
    box-shadow: 0 14px 0px var(--color-dark);
    background: var(--color-neon);
  }
  .stat-val { display: block; font-size: 2.5rem; font-weight: 800; font-family: var(--font-heading); color: var(--color-dark); }
  .stat-lbl { font-size: 0.85rem; color: var(--color-dark); text-transform: uppercase; letter-spacing: 1px; font-weight: 700; }

  /* Grid */
  .admin-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
    margin-bottom: 2rem;
  }
  @media(max-width: 900px) { .admin-grid { grid-template-columns: 1fr; } }
  
  .admin-card {
    background: var(--color-white);
    padding: 2rem;
    border-radius: 20px;
    border: 2px solid var(--color-dark);
    box-shadow: 0 8px 0px var(--color-dark);
  }
  .card-title-row {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 0.5rem;
  }
  .card-title-row h3 { font-size: 1.5rem; font-weight: 700; color: var(--color-dark); }
  .count-badge {
    background: var(--color-neon); color: var(--color-dark);
    padding: 0.3rem 0.8rem; border-radius: 50px;
    font-size: 0.9rem; font-weight: 800;
    border: 2px solid var(--color-dark);
  }
  .today-badge {
    background: var(--color-white); color: var(--color-dark);
    padding: 0.3rem 0.8rem; border-radius: 50px;
    font-size: 0.85rem; font-weight: 700;
    border: 2px solid var(--color-dark);
  }
  .card-subtitle { color: var(--color-dark); font-size: 0.95rem; font-weight: 500; margin-bottom: 1.5rem; }

  /* Student list */
  .student-list { list-style: none; padding: 0; max-height: 400px; overflow-y: auto;}
  .student-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1.2rem;
    background: var(--color-white);
    border: 2px solid var(--color-dark);
    border-radius: 14px;
    margin-bottom: 1rem;
    transition: all 0.3s ease;
    box-shadow: 0 4px 0px var(--color-dark);
  }
  .student-item:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 0px var(--color-dark);
  }
  .student-left { display: flex; align-items: center; gap: 1rem; }
  .s-avatar {
    width: 48px; height: 48px;
    background: var(--color-neon);
    border: 2px solid var(--color-dark);
    border-radius: 12px;
    display: flex; align-items: center; justify-content: center;
    font-weight: 800; font-size: 1rem; color: var(--color-dark);
    flex-shrink: 0;
  }
  .student-info strong { display: block; font-size: 1.1rem; margin-bottom: 0.2rem; font-weight: 700; }
  .student-info span { font-size: 0.9rem; color: var(--color-dark); font-weight: 500; }
  .course-tag {
    display: inline-block;
    background: var(--color-light-bg);
    color: var(--color-dark);
    padding: 0.2rem 0.8rem;
    border-radius: 50px;
    font-size: 0.75rem !important;
    font-weight: 700;
    margin-top: 0.4rem;
    border: 1px solid var(--color-dark);
  }

  /* Attendance */
  .attendance-controls { display: flex; gap: 1rem; margin-bottom: 1.5rem; }
  .date-picker {
    flex: 1; padding: 0.75rem 1rem;
    border: 2px solid var(--color-dark);
    border-radius: 14px; font-family: var(--font-body);
    font-size: 0.95rem; background: var(--color-light-bg);
    cursor: none;
  }
  .date-picker:focus { outline: none; background: var(--color-white); box-shadow: 0 4px 0px var(--color-dark); transform: translateY(-2px); }

  .attendance-btns { display: flex; gap: 0.5rem; }
  .mark-btn {
    border: 2px solid var(--color-dark); padding: 0.5rem 0.9rem;
    border-radius: 10px; font-weight: 700;
    cursor: none; transition: all 0.2s;
    font-size: 0.85rem; font-family: var(--font-body);
    box-shadow: 0 2px 0px var(--color-dark);
  }
  .mark-btn:hover { transform: translateY(2px); box-shadow: none; }
  .present-btn { background: var(--color-white); color: var(--color-dark); }
  .absent-btn { background: var(--color-white); color: var(--color-dark); }

  .save-row {
    margin-top: 1.5rem;
    padding-top: 1.5rem;
    border-top: 2px dashed var(--color-dark);
  }
  .save-btn { 
    width: 100%; 
    transition: all 0.3s;
    background: var(--color-dark);
    color: var(--color-neon);
    border: 2px solid var(--color-dark);
    padding: 1rem;
    font-size: 1.1rem;
    font-weight: 700;
    border-radius: 14px;
    box-shadow: 0 4px 0px var(--color-neon);
    cursor: none;
  }
  .save-btn:hover {
    transform: translateY(2px);
    box-shadow: 0 2px 0px var(--color-neon);
  }
</style>
