---
import DashboardLayout from '../layouts/DashboardLayout.astro';
---

<DashboardLayout title="Admin Dashboard | Bhavya Career Institute">
  <div class="admin-container container">
    <!-- Password Overlay -->
    <div id="password-overlay" class="password-overlay hidden">
      <div class="password-card">
        <h3>Admin Access</h3>
        <p>Please enter the admin password to continue.</p>
        <input type="password" id="admin-password-input" placeholder="Password" />
        <button id="admin-password-btn" class="btn btn-primary-glow" style="width: 100%;">Unlock Dashboard</button>
      </div>
    </div>

    <!-- Student Details Modal -->
    <div id="student-details-modal" class="password-overlay hidden">
      <div class="password-card" style="max-width: 500px; text-align: left;">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
          <h3 id="details-name" style="margin: 0;">Student Name</h3>
          <button id="close-details-btn" style="background: none; border: none; font-size: 1.5rem; cursor: pointer; color: #666;">&times;</button>
        </div>
        <div style="margin-bottom: 1rem; font-size: 0.95rem; color: #444;">
          <strong>Email:</strong> <span id="details-email"></span><br>
          <strong>Course:</strong> <span id="details-course"></span>
        </div>
        <h4 style="margin-bottom: 0.5rem; font-size: 1.1rem;">Attendance History</h4>
        <ul id="details-attendance-list" style="list-style: none; padding: 0; max-height: 250px; overflow-y: auto; border: 1px solid #eee; border-radius: 8px; padding: 0.5rem; background: #fafafa;">
          <li>Loading...</li>
        </ul>
      </div>
    </div>

    <div id="loading" class="loading-state">
      <div class="loader-ring"><div></div><div></div><div></div><div></div></div>
      <p>Loading admin dashboard...</p>
    </div>

    <div id="admin-main" class="hidden">
      <div class="admin-header">
        <div>
          <p class="welcome-label" id="admin-greeting">Good morning 👋</p>
          <h2>Teacher Dashboard</h2>
          <p class="subtitle">Manage students and mark attendance</p>
        </div>
        <div class="header-right">
          <div class="avatar-admin">BC</div>
          <button id="logout-btn" class="btn btn-outline">Log Out</button>
        </div>
      </div>

      <!-- Stats -->
      <div class="admin-stats" id="admin-stats">
        <div class="admin-stat">
          <span class="stat-val" id="stat-total">0</span>
          <span class="stat-lbl">Total Students</span>
        </div>
        <div class="admin-stat">
          <span class="stat-val" id="stat-courses">0</span>
          <span class="stat-lbl">Courses Active</span>
        </div>
        <div class="admin-stat">
          <span class="stat-val" id="stat-today">0</span>
          <span class="stat-lbl">Present Today</span>
        </div>
        <div class="admin-stat">
          <span class="stat-val" id="stat-avg">—</span>
          <span class="stat-lbl">Avg Attendance</span>
        </div>
      </div>

      <div class="admin-grid">
        <!-- Student List -->
        <div class="admin-card">
          <div class="card-title-row">
            <h3>All Students</h3>
            <span class="count-badge" id="student-count">0</span>
          </div>
          <p class="card-subtitle">All enrolled students and their courses.</p>
          <ul id="student-list" class="student-list">
            <li class="loading-item">Loading students...</li>
          </ul>
        </div>

        <!-- Attendance Marking -->
        <div class="admin-card">
          <div class="card-title-row">
            <h3>Mark Attendance</h3>
            <span class="today-badge" id="today-badge">Today</span>
          </div>
          <p class="card-subtitle">Select a date and mark students present or absent.</p>
          
          <div class="attendance-controls">
            <input type="date" id="attendance-date" class="date-picker" />
            <button id="load-students-btn" class="btn">Load Students</button>
          </div>
          
          <div id="attendance-section" class="hidden">
            <ul id="approved-list" class="student-list"></ul>
            <div class="save-row">
              <button id="save-all-btn" class="btn save-btn">💾 Save All Attendance</button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</DashboardLayout>

<script>
  import { auth, db } from '../lib/firebase.js';
  import { onAuthStateChanged, signOut } from 'firebase/auth';
  import { doc, getDoc, collection, query, where, getDocs, setDoc } from 'firebase/firestore';

  document.addEventListener('astro:page-load', () => {
    const loadingView = document.getElementById('loading');
    const adminMain = document.getElementById('admin-main');
    
    // If we're not on the admin page, do nothing
    if (!loadingView || !adminMain) return;

    // Set greeting
    const hour = new Date().getHours();
    const greetEl = document.getElementById('admin-greeting');
    if (greetEl) {
      if (hour < 12) greetEl.textContent = 'Good morning ☀️';
      else if (hour < 17) greetEl.textContent = 'Good afternoon 🌤️';
      else greetEl.textContent = 'Good evening 🌙';
    }

    // Set today's date
    const datePicker = document.getElementById('attendance-date') as HTMLInputElement;
    if (datePicker) {
      datePicker.valueAsDate = new Date();
    }

    const logoutBtn = document.getElementById('logout-btn');
    if (logoutBtn) {
      logoutBtn.addEventListener('click', () => {
        window.location.href = '/';
      });
    }

    // Show password overlay on page load (bypassing Firebase Auth for admin access)
    loadingView.classList.add('hidden');
    const pwdOverlay = document.getElementById('password-overlay')!;
    pwdOverlay.classList.remove('hidden');

    const pwdBtn = document.getElementById('admin-password-btn');
    if (pwdBtn) {
      pwdBtn.addEventListener('click', () => {
        const pwdInput = (document.getElementById('admin-password-input') as HTMLInputElement).value;
        if (pwdInput === '9024546041') {
          pwdOverlay.classList.add('hidden');
          adminMain.classList.remove('hidden');
          loadStudentList();
        } else {
          alert('Incorrect password');
        }
      });
    }

    // Student Details Modal Logic
    const detailsModal = document.getElementById('student-details-modal')!;
    const detailsName = document.getElementById('details-name')!;
    const detailsEmail = document.getElementById('details-email')!;
    const detailsCourse = document.getElementById('details-course')!;
    const detailsAttendance = document.getElementById('details-attendance-list')!;
    
    const closeBtn = document.getElementById('close-details-btn');
    if (closeBtn) {
      closeBtn.addEventListener('click', () => {
        detailsModal.classList.add('hidden');
      });
    }

    async function showStudentDetails(student: any) {
      detailsName.textContent = student.name || 'Unknown';
      detailsEmail.textContent = student.email || 'No email';
      detailsCourse.textContent = student.course || 'No course';
      detailsAttendance.innerHTML = '<li style="padding: 0.5rem; color: #666;">Loading attendance...</li>';
      detailsModal.classList.remove('hidden');

      try {
        const q = query(collection(db, 'attendance'), where('studentId', '==', student.uid));
        const snap = await getDocs(q);
        
        detailsAttendance.innerHTML = '';
        if (snap.empty) {
          detailsAttendance.innerHTML = '<li style="padding: 0.5rem; color: #666;">No attendance records found.</li>';
          return;
        }

        const records: any[] = [];
        snap.forEach(d => records.push(d.data()));
        
        // Sort by date descending
        records.sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime());

        records.forEach(r => {
          const li = document.createElement('li');
          li.style.padding = '0.7rem 0.5rem';
          li.style.borderBottom = '1px solid #eee';
          li.style.display = 'flex';
          li.style.justifyContent = 'space-between';
          
          const dateStr = new Date(r.date).toLocaleDateString('en-US', { weekday: 'short', month: 'short', day: 'numeric', year: 'numeric' });
          const statusColor = r.status === 'present' ? '#4CAF50' : '#f44336';
          
          li.innerHTML = `
            <span>${dateStr}</span>
            <span style="color: ${statusColor}; font-weight: bold; text-transform: uppercase; font-size: 0.8rem; background: ${r.status === 'present' ? '#e8f5e9' : '#ffebee'}; padding: 0.2rem 0.6rem; border-radius: 50px;">${r.status}</span>
          `;
          detailsAttendance.appendChild(li);
        });
      } catch (e) {
        console.error(e);
        detailsAttendance.innerHTML = '<li style="padding: 0.5rem; color: #f44336;">Failed to load attendance.</li>';
      }
    }

    async function loadStudentList() {
      const listEl = document.getElementById('student-list')!;
      if (!listEl) return;
      try {
        const q = query(collection(db, 'users'), where('role', '==', 'student'));
        const snapshot = await getDocs(q);
        
        listEl.innerHTML = '';
        
        const courses = new Set<string>();
        let count = 0;
        
        if (snapshot.empty) {
          listEl.innerHTML = '<li class="empty-msg">No students enrolled yet.</li>';
        } else {
          snapshot.forEach((docSnap) => {
            const student = docSnap.data();
            count++;
            if (student.course) courses.add(student.course);
            
            const initials = (student.name || 'S').split(' ').map((w: string) => w[0]).join('').toUpperCase().slice(0, 2);
            
            const li = document.createElement('li');
            li.className = 'student-item';
            li.style.cursor = 'pointer';
            li.innerHTML = `
              <div class="student-left">
                <div class="s-avatar">${initials}</div>
                <div class="student-info">
                  <strong>${student.name}</strong>
                  <span>${student.email}</span>
                  <small class="course-tag">${student.course || 'No course'}</small>
                </div>
              </div>
              <div style="color: rgba(43,43,43,0.3); display: flex; align-items: center;">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6"/></svg>
              </div>
            `;
            li.addEventListener('click', () => showStudentDetails(student));
            listEl.appendChild(li);
          });
        }
        
        const studentCountEl = document.getElementById('student-count');
        const statTotalEl = document.getElementById('stat-total');
        const statCoursesEl = document.getElementById('stat-courses');

        if (studentCountEl) studentCountEl.textContent = String(count);
        if (statTotalEl) statTotalEl.textContent = String(count);
        if (statCoursesEl) statCoursesEl.textContent = String(courses.size);
        
      } catch (error: any) {
        listEl.innerHTML = `<li class="empty-msg">Error loading students: ${error.message}</li>`;
        console.error('Error loading students:', error);
      }

      try {
        // Load today's attendance count
        const today = new Date().toISOString().split('T')[0];
        const attQ = query(collection(db, 'attendance'), where('date', '==', today), where('status', '==', 'present'));
        const attSnap = await getDocs(attQ);
        const statTodayEl = document.getElementById('stat-today');
        if (statTodayEl) statTodayEl.textContent = String(attSnap.size);
      } catch (error: any) {
        console.error('Error loading today attendance count:', error);
        const statTodayEl = document.getElementById('stat-today');
        if (statTodayEl) statTodayEl.textContent = 'Err';
      }
    }

    // Load students for attendance marking
    const attendanceData: Record<string, string> = {}; // uid -> status

    const loadStudentsBtn = document.getElementById('load-students-btn');
    if (loadStudentsBtn) {
      loadStudentsBtn.addEventListener('click', async () => {
        const selectedDate = datePicker?.value;
        if (!selectedDate) {
          alert("Please select a date");
          return;
        }

        const listEl = document.getElementById('approved-list')!;
        const section = document.getElementById('attendance-section')!;
        if (!listEl || !section) return;

        try {
          section.classList.remove('hidden');
          listEl.innerHTML = '<li class="loading-item">Loading students...</li>';
          
          const q = query(collection(db, 'users'), where('role', '==', 'student'));
          const snapshot = await getDocs(q);
          
          listEl.innerHTML = '';
          
          if (snapshot.empty) {
            listEl.innerHTML = '<li class="empty-msg">No students found.</li>';
          } else {
            snapshot.forEach((docSnap) => {
              const student = docSnap.data();
              const initials = (student.name || 'S').split(' ').map((w: string) => w[0]).join('').toUpperCase().slice(0, 2);
              
              const li = document.createElement('li');
              li.className = 'student-item attendance-item';
              li.dataset.uid = student.uid;
              li.innerHTML = `
                <div class="student-left">
                  <div class="s-avatar">${initials}</div>
                  <div class="student-info">
                    <strong>${student.name}</strong>
                    <span>${student.email}</span>
                  </div>
                </div>
                <div class="attendance-actions">
                  <button class="mark-btn present-btn" data-uid="${student.uid}" data-status="present">✓ Present</button>
                  <button class="mark-btn absent-btn" data-uid="${student.uid}" data-status="absent">✗ Absent</button>
                </div>
              `;
              listEl.appendChild(li);
            });
            
            // Add event listeners
            document.querySelectorAll('.mark-btn').forEach(btn => {
              btn.addEventListener('click', (e) => {
                const target = e.target as HTMLButtonElement;
                const uid = target.dataset.uid!;
                const status = target.dataset.status!;
                const item = target.closest('.attendance-item') as HTMLElement;
                
                attendanceData[uid] = status;
                
                if (status === 'present') {
                  item.style.borderLeft = '4px solid #4CAF50';
                  item.style.background = '#f1f8f1';
                  const absent = item.querySelector('.absent-btn') as HTMLButtonElement;
                  if (absent) { absent.style.opacity = '0.4'; }
                  target.style.background = '#4CAF50';
                  target.style.color = 'white';
                } else {
                  item.style.borderLeft = '4px solid #f44336';
                  item.style.background = '#fff5f5';
                  const present = item.querySelector('.present-btn') as HTMLButtonElement;
                  if (present) { present.style.opacity = '0.4'; }
                  target.style.background = '#f44336';
                  target.style.color = 'white';
                }
              });
            });
          }
        } catch (error: any) {
          listEl.innerHTML = `<li class="empty-msg">Error loading students: ${error.message}</li>`;
          console.error('Error in mark attendance load:', error);
        }
      });
    }

    // Save all attendance
    const saveAllBtn = document.getElementById('save-all-btn');
    if (saveAllBtn) {
      saveAllBtn.addEventListener('click', async () => {
        const selectedDate = datePicker?.value;
        if (!selectedDate) return;
        
        const saveBtn = document.getElementById('save-all-btn') as HTMLButtonElement;
        
        try {
          saveBtn.textContent = 'Saving...';
          saveBtn.disabled = true;
          
          const promises = Object.entries(attendanceData).map(([uid, status]) => {
            const recordId = `${uid}_${selectedDate}`;
            return setDoc(doc(db, 'attendance', recordId), {
              studentId: uid,
              date: selectedDate,
              status: status,
              markedAt: new Date().toISOString()
            });
          });
          
          await Promise.all(promises);
          
          saveBtn.textContent = '✓ All Attendance Saved!';
          saveBtn.style.background = '#4CAF50';
          saveBtn.style.color = 'white';
          
          setTimeout(() => {
            saveBtn.textContent = '💾 Save All Attendance';
            saveBtn.style.background = '';
            saveBtn.style.color = '';
            saveBtn.disabled = false;
          }, 2000);
          
        } catch (error: any) {
          alert('Error saving attendance: ' + error.message);
          saveBtn.textContent = '💾 Save All Attendance';
          saveBtn.disabled = false;
        }
      });
    }
  });
</script>

<style is:global>
  .admin-container {
    padding: 3rem 2rem 5rem;
    max-width: 1200px;
    margin: 0 auto;
  }

  .hidden { display: none !important; }

  .password-overlay {
    position: fixed; inset: 0;
    background: rgba(255,255,255,0.85);
    backdrop-filter: blur(15px);
    display: flex; align-items: center; justify-content: center;
    z-index: 9999;
  }
  .password-card {
    background: var(--color-white);
    padding: 3rem;
    border-radius: 24px;
    width: 90%; max-width: 420px;
    text-align: center;
    border: 2px solid var(--color-dark);
    box-shadow: 0 12px 0px var(--color-dark);
    animation: scale-up 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
  }
  @keyframes scale-up {
    from { transform: scale(0.9); opacity: 0; }
    to { transform: scale(1); opacity: 1; }
  }
  .password-card h3 { margin-bottom: 0.5rem; font-size: 1.8rem; color: var(--color-dark); font-family: var(--font-heading); font-weight: 800; }
  .password-card p { color: var(--color-dark); font-weight: 500; margin-bottom: 2rem; font-size: 0.95rem; }
  .password-card input {
    width: 100%; padding: 1rem 1.2rem;
    background: var(--color-light-bg);
    border: 2px solid var(--color-dark);
    color: var(--color-dark);
    border-radius: 12px; margin-bottom: 1.5rem;
    font-size: 1rem; text-align: center;
    font-family: inherit;
    font-weight: 600;
    transition: all 0.3s;
    cursor: none;
  }
  .password-card input:focus {
    outline: none;
    background: var(--color-white);
    box-shadow: 0 4px 0px var(--color-dark);
    transform: translateY(-2px);
  }
  
  .btn-primary-glow {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: var(--color-dark);
    color: var(--color-neon);
    padding: 1rem 1.5rem;
    border-radius: 14px;
    font-weight: 700;
    transition: all 0.3s;
    border: 2px solid var(--color-dark);
    cursor: none;
    box-shadow: 0 6px 0px var(--color-neon);
  }
  .btn-primary-glow:hover {
    transform: translateY(-2px);
    box-shadow: 0 4px 0px var(--color-neon);
  }

  .loading-state {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: 50vh;
    text-align: center;
    color: var(--color-dark);
    font-weight: 600;
  }
  .loader-ring {
    display: inline-block;
    position: relative;
    width: 56px;
    height: 56px;
    margin-bottom: 1.5rem;
  }
  .loader-ring div {
    box-sizing: border-box;
    display: block;
    position: absolute;
    width: 48px;
    height: 48px;
    margin: 4px;
    border: 4px solid var(--color-dark);
    border-radius: 50%;
    animation: ring-spin 1.2s cubic-bezier(0.5, 0, 0.5, 1) infinite;
    border-color: var(--color-dark) transparent transparent transparent;
  }
  .loader-ring div:nth-child(1) { animation-delay: -0.45s; }
  .loader-ring div:nth-child(2) { animation-delay: -0.3s; }
  .loader-ring div:nth-child(3) { animation-delay: -0.15s; }
  @keyframes ring-spin {
    0% { transform: rotate(0deg); }
    100% { transform: rotate(360deg); }
  }

  .admin-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: var(--color-white);
    padding: 2rem 2.5rem;
    border-radius: 24px;
    border: 2px solid var(--color-dark);
    box-shadow: 0 8px 0px var(--color-dark);
    margin-bottom: 2rem;
    position: relative;
    overflow: hidden;
  }
  .admin-header::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 6px;
    background: var(--color-neon);
    border-bottom: 2px solid var(--color-dark);
  }
  .welcome-label { font-size: 1rem; color: var(--color-dark); font-weight: 600; margin-bottom: 0.3rem; }
  .admin-header h2 { font-size: 2.2rem; margin-bottom: 0.3rem; font-weight: 700; color: var(--color-dark); }
  .subtitle { color: var(--color-dark); font-size: 0.95rem; font-weight: 500; }
  .header-right { display: flex; align-items: center; gap: 1.5rem; }
  .avatar-admin {
    width: 60px; height: 60px;
    background: var(--color-white);
    border: 2px solid var(--color-dark);
    border-radius: 16px;
    display: flex; align-items: center; justify-content: center;
    font-weight: 700; font-size: 1.3rem; color: var(--color-dark);
    box-shadow: 0 4px 0px var(--color-dark);
  }

  /* Stats */
  .admin-stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5rem;
    margin-bottom: 2rem;
  }
  @media(max-width: 768px) { .admin-stats { grid-template-columns: 1fr 1fr; } }
  .admin-stat {
    background: var(--color-white);
    padding: 1.5rem;
    border-radius: 20px;
    text-align: center;
    border: 2px solid var(--color-dark);
    box-shadow: 0 6px 0px var(--color-dark);
    transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    cursor: none;
  }
  .admin-stat:hover { 
    transform: translateY(-8px); 
    box-shadow: 0 14px 0px var(--color-dark);
    background: var(--color-neon);
  }
  .stat-val { display: block; font-size: 2.5rem; font-weight: 800; color: var(--color-dark); font-family: var(--font-heading); }
  .stat-lbl { font-size: 0.85rem; color: var(--color-dark); text-transform: uppercase; letter-spacing: 1px; font-weight: 700; }

  /* Grid */
  .admin-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
  }
  @media(max-width: 900px) { .admin-grid { grid-template-columns: 1fr; } }

  .admin-card {
    background: var(--color-white);
    padding: 2rem;
    border-radius: 20px;
    border: 2px solid var(--color-dark);
    box-shadow: 0 8px 0px var(--color-dark);
  }
  .card-title-row {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 0.5rem;
  }
  .card-title-row h3 { font-size: 1.5rem; font-weight: 700; color: var(--color-dark); }
  .count-badge, .today-badge {
    background: var(--color-neon); color: var(--color-dark);
    padding: 0.3rem 0.8rem; border-radius: 50px;
    font-size: 0.9rem; font-weight: 800; text-transform: uppercase; letter-spacing: 1px;
    border: 2px solid var(--color-dark);
  }
  .card-subtitle { color: var(--color-dark); font-size: 0.95rem; font-weight: 500; margin-bottom: 1.5rem; }

  /* Student list */
  .student-list { list-style: none; padding: 0; max-height: 400px; overflow-y: auto; padding-right: 0.5rem; }
  .student-list::-webkit-scrollbar { width: 6px; }
  .student-list::-webkit-scrollbar-thumb { background: var(--color-dark); border-radius: 10px; }
  
  .student-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1.2rem;
    background: var(--color-white);
    border: 2px solid var(--color-dark);
    border-radius: 14px;
    margin-bottom: 1rem;
    transition: all 0.3s ease;
    box-shadow: 0 4px 0px var(--color-dark);
  }
  .student-item:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 0px var(--color-dark);
  }
  .student-left { display: flex; align-items: center; gap: 1rem; }
  .s-avatar {
    width: 48px; height: 48px;
    background: var(--color-neon);
    border: 2px solid var(--color-dark);
    border-radius: 12px;
    display: flex; align-items: center; justify-content: center;
    font-weight: 800; font-size: 1rem; color: var(--color-dark);
